<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>FlexRt</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlexRt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Parsing\Plc\Card\Dictionaries\*.bin" LogicalName="FlexRt.Card.%(Filename).bin" />
  </ItemGroup>
</Project>
