<div class="inspector-head">
    <span class="inspector-title">@HeadTitle()</span>
    <span class="spacer"></span>
    <div class="head-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(_outer == PropertiesTab ? "true" : "false")" class="head-tab @(_outer == PropertiesTab ? "active" : "")"
                @onclick="() => _outer = PropertiesTab">
            <RadzenIcon Icon="manage_search" /> Properties
        </button>
        <button type="button" role="tab" aria-selected="@(_outer == InfoTab ? "true" : "false")" class="head-tab @(_outer == InfoTab ? "active" : "")"
                @onclick="() => _outer = InfoTab">
            <RadzenIcon Icon="info" /> Info
        </button>
        <button type="button" role="tab" aria-selected="@(_outer == ErrorsTab ? "true" : "false")" class="head-tab @(_outer == ErrorsTab ? "active" : "")"
                @onclick="() => _outer = ErrorsTab">
            @if (Problems().Count > 0)
            {
                <RadzenIcon Icon="@(HasErrors() ? "error" : "warning")" class="@(HasErrors() ? "problem-error" : "problem-warning")" />
            }
            Ошибки
            @if (Problems().Count > 0)
            {
                <span class="badge @(HasErrors() ? "badge-error" : "")">@Problems().Count</span>
            }
        </button>
    </div>
</div>

@if (_outer != PropertiesTab)
{
    <div class="info-body" role="tabpanel">
        @if (ShownLines().Count == 0)
        {
            <div class="muted">@(_outer == InfoTab ? "Сообщений нет" : "Ошибок и предупреждений нет")</div>
        }
        @foreach (var line in ShownLines())
        {
            <div class="info-line @LineClass(line.Level)"><RadzenIcon Icon="@(line.Level == TranscriptLevel.Error ? "error" : "warning")" Visible="@(line.Level != TranscriptLevel.Info)" />@line.Text</div>
        }
    </div>
}
else if (Row is not null)
{
    <RowProperties Row="Row" />
}
else if (Hint is not null)
{
    <div class="muted">@Hint</div>
}
else
{
    <RadzenTabs class="inspector-tabs" @bind-SelectedIndex="_innerTab">
        <Tabs>
            <RadzenTabsItem Text="Properties">@PropertiesView()</RadzenTabsItem>
            <RadzenTabsItem Text="Animations">@NotParsed("Animations")</RadzenTabsItem>
            <RadzenTabsItem Text="Events">@NotParsed("Events")</RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    /// <summary>Подсказка, пока объект не выбран.</summary>
    private const string NoSelectionHint = "Выберите экран в дереве проекта";

    /// <summary>Вкладка заголовка со свойствами объекта.</summary>
    private const string PropertiesTab = "Properties";

    /// <summary>Вкладка заголовка с основным текстом чтения панели и данных ПЛК (строки уровня Info).</summary>
    private const string InfoTab = "Info";

    /// <summary>Вкладка заголовка с ошибками и предупреждениями (решение пользователя: отдельно от Info, со значком).</summary>
    private const string ErrorsTab = "Ошибки";

    /// <summary>Группа свойств по умолчанию.</summary>
    private const string GeneralGroup = "General";

    /// <summary>Группа свойства в списке слева, как в TIA; свойства, которых здесь нет, — в <see cref="GeneralGroup"/>.</summary>
    private static readonly Dictionary<string, string> GroupOf = new()
    {
        ["Width"] = "Layout",
        ["Height"] = "Layout"
    };

    /// <summary>Открытая вкладка заголовка: <see cref="PropertiesTab"/>, <see cref="InfoTab"/> или <see cref="ErrorsTab"/>.</summary>
    private string _outer = PropertiesTab;

    /// <summary>Открытая внутренняя вкладка (Properties, Animations, Events): хранится здесь, чтобы не сбрасываться при переходе на Info.</summary>
    private int _innerTab;

    /// <summary>Выбранная группа свойств; <c>null</c> или группы нет у объекта — первая группа.</summary>
    private string? _selectedGroup;

    /// <summary>Объект, свойства которого показываются; <c>null</c> — подсказка.</summary>
    [Parameter]
    public ScreenItem? Item { get; set; }

    /// <summary>Выбранная строка таблицы раздела: вместо свойств экрана — её ячейки; <c>null</c> — показывается экран.</summary>
    [Parameter]
    public SectionRow? Row { get; set; }

    /// <summary>Подсказка вместо свойств, когда открыт раздел, а строка не выбрана; <c>null</c> — показывается экран.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>
    /// Текст чтения панели и данных ПЛК (<see cref="RunTranscript"/>, раньше его печатала консоль) и сообщения о
    /// разделах, которые не построены: строки Info — на вкладке Info, предупреждения и ошибки — на вкладке «Ошибки».
    /// </summary>
    [Parameter]
    public IReadOnlyList<TranscriptLine> Lines { get; set; } = [];

    /// <summary>
    /// Вкладка свойств: список групп слева (как Property list в TIA) и поля показываемой группы — выбранной, если она
    /// есть у объекта, иначе первой. Start screen показывается флажком по <see cref="ScreenItem.IsStart"/>.
    /// Объект не выбран — подсказка.
    /// </summary>
    /// <returns>Разметка вкладки.</returns>
    private RenderFragment PropertiesView() => __builder =>
    {
        if (Item is null)
        {
            <div class="muted">@NoSelectionHint</div>
            return;
        }
        var groups = Groups(Item);
        var current = groups.FirstOrDefault(g => g.Key == _selectedGroup) ?? groups[0];
        <div class="props-layout">
            <RadzenListBox TValue="string" Data="@groups.Select(g => g.Key).ToList()" Value="@current.Key" ValueChanged="@(g => _selectedGroup = g)" class="props-nav" />
            <div class="props-body">
                <RadzenFieldset Text="@current.Key" class="prop-group">
                    @foreach (var (name, value) in current)
                    {
                        <div class="prop-row">
                            <RadzenLabel Text="@($"{name}:")" />
                            <PropertyValue Value="value" Checked="@(name == StartScreenColumn.Name ? Item.IsStart : null)" />
                        </div>
                    }
                </RadzenFieldset>
            </div>
        </div>
    };

    /// <summary>
    /// Заголовок панели: у строки раздела — первая ячейка и раздел (<c>Screen Number [HMI tags]</c>), у экрана — имя и вид,
    /// иначе — «Свойства».
    /// </summary>
    /// <returns>Текст заголовка.</returns>
    private string HeadTitle()
    {
        if (Row is null)
        {
            return Item is null || Hint is not null ? "Свойства" : $"{Item.Name} [{Item.Kind}]";
        }
        var first = Row.Section.Table.Rows[Row.Index][0].Display;
        return $"{(first == "" ? $"Строка {Row.Index + 1}" : first)} [{Row.Section.Title}]";
    }

    /// <summary>Вкладка, данных для которой в pdata.fwc пока не найдено.</summary>
    /// <returns>Разметка подсказки.</returns>
    private RenderFragment NotParsed(string tab) =>
        @<div class="muted">@(Item is null ? NoSelectionHint : $"{tab}: не разобрано — в pdata.fwc пока не найдено.")</div>;

    /// <summary>Строки вкладки Info: уровня <see cref="TranscriptLevel.Info"/>.</summary>
    /// <returns>Строки в порядке текста.</returns>
    private List<TranscriptLine> InfoLines() => [.. Lines.Where(l => l.Level == TranscriptLevel.Info)];

    /// <summary>Строки вкладки «Ошибки»: предупреждения и ошибки в порядке текста.</summary>
    /// <returns>Строки не уровня <see cref="TranscriptLevel.Info"/>.</returns>
    private List<TranscriptLine> Problems() => [.. Lines.Where(l => l.Level != TranscriptLevel.Info)];

    /// <summary>Есть ли ошибки: значок вкладки «Ошибки» красный, иначе (одни предупреждения) — жёлтый.</summary>
    /// <returns><c>true</c>, если есть строка уровня <see cref="TranscriptLevel.Error"/>.</returns>
    private bool HasErrors() => Lines.Any(l => l.Level == TranscriptLevel.Error);

    /// <summary>Строки открытой вкладки сообщений: Info — <see cref="InfoLines"/>, «Ошибки» — <see cref="Problems"/>.</summary>
    /// <returns>Строки в порядке текста.</returns>
    private List<TranscriptLine> ShownLines() => _outer == InfoTab ? InfoLines() : Problems();

    /// <summary>CSS-класс строки по уровню: предупреждение и ошибка — с иконкой и цветом, обычная строка — без.</summary>
    /// <returns>Имена классов; у обычной строки — пусто.</returns>
    private static string LineClass(TranscriptLevel level) => level switch
    {
        TranscriptLevel.Warning => "problem-line info-warning",
        TranscriptLevel.Error => "problem-line info-error",
        _ => ""
    };

    /// <summary>Свойства объекта по группам в порядке первого свойства группы.</summary>
    /// <returns>Группы свойств.</returns>
    private static List<IGrouping<string, (string Name, ReportCell Value)>> Groups(ScreenItem item) =>
        [.. item.Properties.GroupBy(p => GroupOf.GetValueOrDefault(p.Name, GeneralGroup))];
}
