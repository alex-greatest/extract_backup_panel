@using FlexRt.Export.PanelData.Screens
@using FlexRt.Model.Panel.Screens
@implements IDisposable
@inject ObjectSelection Selection

<div class="inspector-head">
    <span class="inspector-title">@HeadTitle()</span>
    <span class="spacer"></span>
    <div class="head-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(_outer == PropertiesTab ? "true" : "false")" class="head-tab @(_outer == PropertiesTab ? "active" : "")"
                @onclick="() => _outer = PropertiesTab">
            <RadzenIcon Icon="manage_search" /> Properties
        </button>
        <button type="button" role="tab" aria-selected="@(_outer == InfoTab ? "true" : "false")" class="head-tab @(_outer == InfoTab ? "active" : "")"
                @onclick="() => _outer = InfoTab">
            <RadzenIcon Icon="info" /> Info
        </button>
        <button type="button" role="tab" aria-selected="@(_outer == ErrorsTab ? "true" : "false")" class="head-tab @(_outer == ErrorsTab ? "active" : "")"
                @onclick="() => _outer = ErrorsTab">
            @if (Problems().Count > 0)
            {
                <RadzenIcon Icon="@(HasErrors() ? "error" : "warning")" class="@(HasErrors() ? "problem-error" : "problem-warning")" />
            }
            Ошибки
            @if (Problems().Count > 0)
            {
                <span class="badge @(HasErrors() ? "badge-error" : "")">@Problems().Count</span>
            }
        </button>
    </div>
</div>

@if (_outer != PropertiesTab)
{
    <div class="info-body" role="tabpanel">
        @if (ShownLines().Count == 0)
        {
            <div class="muted">@(_outer == InfoTab ? "Сообщений нет" : "Ошибок и предупреждений нет")</div>
        }
        @foreach (var line in ShownLines())
        {
            <div class="info-line @LineClass(line.Level)"><RadzenIcon Icon="@(line.Level == TranscriptLevel.Error ? "error" : "warning")" Visible="@(line.Level != TranscriptLevel.Info)" />@line.Text</div>
        }
    </div>
}
else if (Administration is not null)
{
    <UserProperties State="Administration" Language="Language" />
}
else if (Row is not null)
{
    <RowProperties Row="Row" />
}
else if (Picture is not null)
{
    <PictureProperties Picture="Picture" OnOpen="OnOpenPicture" />
}
else if (Hint is not null)
{
    <div class="muted">@Hint</div>
}
else if (Selection.Of(Item) is { } selected)
{
    @* @key: RadzenTabs запоминает содержимое вкладок — при смене объекта вкладки пересоздаются *@
    <RadzenTabs @key="selected" class="inspector-tabs" @bind-SelectedIndex="_objectTab">
        <Tabs>
            <RadzenTabsItem Text="Properties"><ObjectProperties Object="selected" Field="@Field(selected)" Tags="Tags" @bind-Section="_objectSection" /></RadzenTabsItem>
            @foreach (var tab in ObjectTabs)
            {
                <RadzenTabsItem Text="@tab"><div class="muted">Не разобрано</div></RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
else
{
    <RadzenTabs class="inspector-tabs" @bind-SelectedIndex="_innerTab">
        <Tabs>
            <RadzenTabsItem Text="Properties">@PropertiesView()</RadzenTabsItem>
            <RadzenTabsItem Text="Animations">@AnimationsView()</RadzenTabsItem>
            <RadzenTabsItem Text="Events">@EventsView()</RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    /// <summary>Вкладка заголовка со свойствами объекта.</summary>
    private const string PropertiesTab = "Properties";

    /// <summary>Свойства выбранного пользователя или группы вместо строки общего отчёта.</summary>
    [Parameter]
    public UserAdministration? Administration { get; set; }

    /// <summary>Вкладка заголовка с основным текстом чтения панели и данных ПЛК (строки уровня Info).</summary>
    private const string InfoTab = "Info";

    /// <summary>Вкладка заголовка с ошибками и предупреждениями (решение пользователя: отдельно от Info, со значком).</summary>
    private const string ErrorsTab = "Ошибки";

    /// <summary>Группа свойств по умолчанию.</summary>
    private const string GeneralGroup = "General";

    /// <summary>Группа свойства в списке слева, как в TIA; свойства, которых здесь нет, — в <see cref="GeneralGroup"/>.</summary>
    private static readonly Dictionary<string, string> GroupOf = new()
    {
        ["Width"] = "Layout",
        ["Height"] = "Layout"
    };

    /// <summary>Вкладки объекта холста после Properties, как в TIA; их свойства программа не читает.</summary>
    private static readonly string[] ObjectTabs = ["Animations", "Events", "Texts"];

    /// <summary>Открытая вкладка объекта холста (Properties, Animations, Events, Texts).</summary>
    private int _objectTab;

    /// <summary>Раздел Property list объекта холста: остаётся при выборе другого объекта, как в TIA.</summary>
    private string? _objectSection;

    /// <summary>Открытая вкладка заголовка: <see cref="PropertiesTab"/>, <see cref="InfoTab"/> или <see cref="ErrorsTab"/>.</summary>
    private string _outer = PropertiesTab;

    /// <summary>Открытая внутренняя вкладка (Properties, Animations, Events): хранится здесь, чтобы не сбрасываться при переходе на Info.</summary>
    private int _innerTab;

    /// <summary>Выбранная группа свойств; <c>null</c> или группы нет у объекта — первая группа.</summary>
    private string? _selectedGroup;

    /// <summary>Объект, свойства которого показываются; <c>null</c> — подсказка.</summary>
    [Parameter]
    public ScreenItem? Item { get; set; }

    /// <summary>Таблица листа «Теги» открытой панели — для PLC tag и Address I/O field; нет — <c>null</c>.</summary>
    [Parameter]
    public ReportTable? Tags { get; set; }

    /// <summary>Выбранная строка таблицы раздела: вместо свойств экрана — её ячейки; <c>null</c> — показывается экран.</summary>
    [Parameter]
    public SectionRow? Row { get; set; }

    /// <summary>Выбранная картинка: вместо свойств экрана — её свойства и она сама; <c>null</c> — картинка не выбрана.</summary>
    [Parameter]
    public PictureItem? Picture { get; set; }

    /// <summary>Щелчок по картинке в свойствах: открыть её на всё окно.</summary>
    [Parameter]
    public EventCallback<PictureItem> OnOpenPicture { get; set; }

    /// <summary>
    /// Язык (LCID), выбранный в списке языков окна: на нём показывается Tooltip экрана; <c>null</c> — «Все языки» или не
    /// выбран (Tooltip — на первом языке панели).
    /// </summary>
    [Parameter]
    public int? Language { get; set; }

    /// <summary>Подсказка вместо свойств, когда открыт раздел, а строка не выбрана; <c>null</c> — показывается экран.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>
    /// Текст чтения панели и данных ПЛК (<see cref="RunTranscript"/>) и сообщения о
    /// разделах, которые не построены: строки Info — на вкладке Info, предупреждения и ошибки — на вкладке «Ошибки».
    /// </summary>
    [Parameter]
    public IReadOnlyList<TranscriptLine> Lines { get; set; } = [];

    /// <summary>
    /// Вкладка свойств, как у объекта холста: Property list слева (<see cref="PropertyList"/>), справа заголовок группы с
    /// линией и серые блоки (<see cref="PropertyGroup"/>) с полями показываемой группы — выбранной, если она есть у объекта,
    /// иначе первой. General — как в TIA, двумя блоками (<see cref="ScreenGeneral"/>): слева поля, Start
    /// screen флажком по <see cref="ScreenItem.IsStart"/>, справа — блоки групп текстов (Tooltip) на языке <see cref="Language"/>. Объект не
    /// выбран — подсказка.
    /// </summary>
    /// <returns>Разметка вкладки.</returns>
    private RenderFragment PropertiesView() => __builder =>
    {
        if (Item is null)
        {
            <div class="muted">@Hints.NoScreen</div>
            return;
        }
        var groups = Groups(Item);
        var current = groups.FirstOrDefault(g => g.Key == _selectedGroup) ?? groups[0];
        <div class="props-layout object-props">
            <PropertyList Sections="@([.. groups.Select(g => g.Key)])" Selected="@current.Key" SelectedChanged="@(g => _selectedGroup = g)" />
            <div class="props-body object-body">
                <div class="object-title">@current.Key</div>
                @if (current.Key == GeneralGroup)
                {
                    <ScreenGeneral IsStart="Item.IsStart" Properties="@([.. current])" Language="Language" />
                }
                else
                {
                    <PropertyGroup Title="@current.Key">
                        @foreach (var property in current)
                        {
                            <ObjectRow Name="@property.Name" Value="property.Value" />
                        }
                    </PropertyGroup>
                }
            </div>
        </div>
    };

    /// <summary>
    /// Заголовок панели: у строки раздела — первая ячейка и раздел (<c>Screen Number [HMI tags]</c>), у картинки — имя файла
    /// (<c>PICTURE_5.png [Картинки]</c>), у объекта, выбранного на холсте, — имя и тип (<c>I/O field_1 [I/O field]</c>, у
    /// другого объекта — таблица), у экрана — имя и вид, иначе — «Свойства».
    /// </summary>
    /// <returns>Текст заголовка.</returns>
    private string HeadTitle()
    {
        if (Administration is not null)
        {
            return Administration.SelectionTitle;
        }
        if (Picture is not null)
        {
            return $"{Picture.Name} [{PanelPictures.Title}]";
        }
        if (Row is null)
        {
            if (Item is null || Hint is not null)
            {
                return "Свойства";
            }
            return Selection.Of(Item) is { } o ? $"{o.Name} [{(Field(o) is null ? o.Table : "I/O field")}]" : $"{Item.Name} [{Item.Kind}]";
        }
        var first = Row.Section.Table.Rows[Row.Index][0].Display;
        return $"{(first == "" ? $"Строка {Row.Index + 1}" : first)} [{Row.Section.Title}]";
    }

    /// <summary>
    /// Вкладка Animations: Visibility экрана (<see cref="ScreenAnimations"/>) из колонок Visibility строки листа; объект не
    /// выбран — подсказка.
    /// </summary>
    /// <returns>Разметка вкладки.</returns>
    private RenderFragment AnimationsView() => Item is null
        ? @<div class="muted">@Hints.NoScreen</div>
        : @<ScreenAnimations Properties="@([.. Item.Properties.Where(p => IsAnimation(p.Name))])" />;

    /// <summary>
    /// Вкладка Events: события Loaded и Cleared экрана (<see cref="ScreenEvents"/>) с функциями и параметрами; объект не
    /// выбран — подсказка.
    /// </summary>
    /// <returns>Разметка вкладки.</returns>
    private RenderFragment EventsView() => Item is null
        ? @<div class="muted">@Hints.NoScreen</div>
        : @<ScreenEvents Events="Item.Events" />;

    /// <summary>Подписаться на выбор объекта холста: холст — соседний компонент, о смене выбора панель узнаёт событием.</summary>
    protected override void OnInitialized() => Selection.Changed += OnSelectionChanged;

    /// <summary>Отписаться от выбора объекта холста.</summary>
    public void Dispose() => Selection.Changed -= OnSelectionChanged;

    /// <summary>Выбор объекта сменился — перерисовать панель.</summary>
    private void OnSelectionChanged() => InvokeAsync(StateHasChanged);

    /// <summary>I/O field выбранного объекта экрана (<see cref="ScreenItem.Fields"/>).</summary>
    /// <returns>Поле; объект другого типа или экран не выбран — <c>null</c>.</returns>
    private IoField? Field(ScreenObject selected) => Item?.Fields.GetValueOrDefault(selected.Element);

    /// <summary>Строки вкладки Info: уровня <see cref="TranscriptLevel.Info"/>.</summary>
    /// <returns>Строки в порядке текста.</returns>
    private List<TranscriptLine> InfoLines() => [.. Lines.Where(l => l.Level == TranscriptLevel.Info)];

    /// <summary>Строки вкладки «Ошибки»: предупреждения и ошибки в порядке текста.</summary>
    /// <returns>Строки не уровня <see cref="TranscriptLevel.Info"/>.</returns>
    private List<TranscriptLine> Problems() => [.. Lines.Where(l => l.Level != TranscriptLevel.Info)];

    /// <summary>Есть ли ошибки: значок вкладки «Ошибки» красный, иначе (одни предупреждения) — жёлтый.</summary>
    /// <returns><c>true</c>, если есть строка уровня <see cref="TranscriptLevel.Error"/>.</returns>
    private bool HasErrors() => Lines.Any(l => l.Level == TranscriptLevel.Error);

    /// <summary>Строки открытой вкладки сообщений: Info — <see cref="InfoLines"/>, «Ошибки» — <see cref="Problems"/>.</summary>
    /// <returns>Строки в порядке текста.</returns>
    private List<TranscriptLine> ShownLines() => _outer == InfoTab ? InfoLines() : Problems();

    /// <summary>CSS-класс строки по уровню: предупреждение и ошибка — с иконкой и цветом, обычная строка — без.</summary>
    /// <returns>Имена классов; у обычной строки — пусто.</returns>
    private static string LineClass(TranscriptLevel level) => level switch
    {
        TranscriptLevel.Warning => "problem-line info-warning",
        TranscriptLevel.Error => "problem-line info-error",
        _ => ""
    };

    /// <summary>Свойства объекта по группам в порядке первого свойства группы; колонки Visibility — на вкладке Animations, не здесь.</summary>
    /// <returns>Группы свойств.</returns>
    private static List<IGrouping<string, ScreenProperty>> Groups(ScreenItem item) =>
        [.. item.Properties.Where(p => !IsAnimation(p.Name)).GroupBy(p => GroupOf.GetValueOrDefault(p.Name, GeneralGroup))];

    /// <summary>Колонка листа «Экраны» — анимация (<see cref="ScreenVisibilityCells.Columns"/>).</summary>
    /// <returns><c>true</c> — свойство показывается на вкладке Animations.</returns>
    private static bool IsAnimation(string name) => ScreenVisibilityCells.Columns.Contains(name);
}
