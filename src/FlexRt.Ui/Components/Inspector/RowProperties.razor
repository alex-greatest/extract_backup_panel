<div class="props-layout">
    <div class="props-body">
        <RadzenFieldset Text="@($"Строка {Row.Index + 1} листа «{Row.Section.Sheet}»")" class="prop-group row-group">
            @foreach (var (name, value) in Row.Section.Table.Columns.Zip(Row.Section.Table.Rows[Row.Index]))
            {
                <PropertyRow Name="@name" Value="value" />
            }
        </RadzenFieldset>
    </div>
</div>

@code {
    /// <summary>Строка таблицы раздела: поля — ячейки строки под заголовками колонок листа (образец заливки и перенос строк — в <see cref="PropertyValue"/>).</summary>
    [Parameter, EditorRequired]
    public SectionRow Row { get; set; } = null!;
}
