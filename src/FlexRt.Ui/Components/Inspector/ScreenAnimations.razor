@using FlexRt.Export.PanelData.Screens

@if (!HasVisibility())
{
    <div class="muted">Анимаций нет</div>
}
else
{
    <div class="props-layout">
        <nav class="anim-nav" aria-label="Анимации">
            <div class="anim-nav-group"><RadzenIcon Icon="tv" /> Display</div>
            <div class="anim-nav-item selected" aria-current="true"><RadzenIcon Icon="visibility" /> @VisibilityItem</div>
        </nav>
        <div class="props-body">
            <div class="anim-title">@VisibilityItem</div>
            <div class="anim-blocks">
                <RadzenFieldset Text="Process" class="prop-group anim-process">
                    <div class="anim-tag-label">Tag:</div>
                    <div class="anim-tag">
                        <PropertyValue Value="Cell(ScreenVisibilityCells.TagColumn)" />
                    </div>
                    <div role="radiogroup" aria-readonly="true" aria-label="Режим">
                        <div class="anim-mode">
                            @Radio("Range", true, false)
                            <div class="anim-range">
                                <div class="prop-row"><RadzenLabel Text="From:" /><PropertyValue Value="Cell(ScreenVisibilityCells.FromColumn)" /></div>
                                <div class="prop-row"><RadzenLabel Text="To:" /><PropertyValue Value="Cell(ScreenVisibilityCells.ToColumn)" /></div>
                            </div>
                        </div>
                        <div class="anim-mode" title="@SingleBitHint">
                            @Radio("Single bit", false, true)
                        </div>
                    </div>
                </RadzenFieldset>
                <RadzenFieldset Text="@VisibilityItem" class="prop-group anim-state">
                    <div role="radiogroup" aria-readonly="true" aria-label="@VisibilityItem">
                        @Radio(ScreenVisibilityCells.VisibleText, State() == ScreenVisibilityCells.VisibleText, false)
                        @Radio(ScreenVisibilityCells.InvisibleText, State() == ScreenVisibilityCells.InvisibleText, false)
                    </div>
                    @if (State() == ScreensTable.Unknown)
                    {
                        <div class="muted">не прочитано</div>
                    }
                </RadzenFieldset>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Пункт дерева анимаций, заголовок вкладки и блока Visible/Invisible, как в TIA.</summary>
    private const string VisibilityItem = "Visibility";

    /// <summary>Подсказка у неактивного Single bit: у Visibility экрана TIA даёт только режим Range.</summary>
    private const string SingleBitHint = "У Visibility экрана TIA даёт только режим Range";

    /// <summary>
    /// Свойства экрана — ячейки строки листа «Экраны»; вкладка берёт колонки Visibility
    /// (<see cref="ScreenVisibilityCells.Columns"/>).
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ScreenProperty> Properties { get; set; } = [];

    /// <summary>Есть ли у экрана Visibility: колонка тега не пустая (пустая — ссылки на LIMIT нет).</summary>
    /// <returns><c>true</c>, если анимация есть (в том числе не прочитанная — <c>?</c>).</returns>
    private bool HasVisibility() => Cell(ScreenVisibilityCells.TagColumn).Display != "";

    /// <summary>Значение колонки Visibility: <c>Visible</c>, <c>Invisible</c> или <c>?</c>.</summary>
    /// <returns>Текст ячейки.</returns>
    private string State() => Cell(ScreenVisibilityCells.StateColumn).Display;

    /// <summary>Ячейка колонки листа по заголовку.</summary>
    /// <returns>Значение; колонки нет — пустая ячейка.</returns>
    private ReportCell Cell(string column) => Properties.FirstOrDefault(p => p.Name == column)?.Value ?? "";

    /// <summary>
    /// Переключатель только для чтения, как в TIA: кружок и подпись обычного цвета (не бледные, как у отключённого
    /// переключателя Radzen); <paramref name="disabled"/> — недоступный в TIA вариант (Single bit), бледный.
    /// </summary>
    /// <param name="text">Подпись.</param>
    /// <param name="isChecked">Выбран ли вариант.</param>
    /// <param name="disabled">Вариант недоступен.</param>
    /// <returns>Разметка переключателя.</returns>
    private static RenderFragment Radio(string text, bool isChecked, bool disabled) =>
        @<div class="anim-radio @(isChecked ? "checked" : "") @(disabled ? "disabled" : "")" role="radio"
              aria-checked="@(isChecked ? "true" : "false")" aria-disabled="@(disabled ? "true" : "false")">
            <span class="anim-radio-box"></span>@text
        </div>;
}
