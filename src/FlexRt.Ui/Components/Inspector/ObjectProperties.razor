@using FlexRt.Export.PanelData.Tags
@using FlexRt.Model.Panel.Screens

<div class="props-layout object-props">
    <PropertyList Sections="Sections()" Selected="@Current()" SelectedChanged="SectionChanged" />
    <div class="props-body object-body">
        <div class="object-title">@Current()</div>
        @* Поля раздела блоками, как в TIA. General I/O field — Process (тег через неразобранную таблицу — «? (таблица N)»;
           PLC tag и Address — TagCell, серые, как в TIA), Type и Format (Decimal places, Field length и шаблон —
           IoFieldTexts; недоступные в TIA — серые); Appearance — Background, Text и Border; Characteristics — Field
           (Hidden input); Layout — Position & size, у поля ещё Margins; Text format — Format и Alignment; Flashing — None
           или Standard; Limits — Colors: High limit violated и Low limit violated, как в TIA (в файле нет —
           IoFieldTexts.LimitsAbsent); Miscellaneous — Tooltip на выбранном языке; Security — Authorization и Allow
           operator control; Styles/Designs — «Не разобрано». У объекта другого типа General — имя и таблица. *@
        @switch (Current())
        {
            case General when Field is { } f:
                <div class="object-blocks">
                    <div class="object-column">
                        <PropertyGroup Title="Process">
                            <ObjectRow Name="Tag" Value="@(f.Tag ?? (f.TagVia is { } via ? $"? ({via})" : ""))" />
                            <ObjectRow Name="PLC tag" Value="_plcTag" Disabled="true" />
                            <ObjectRow Name="Address" Value="_address" Disabled="true" />
                        </PropertyGroup>
                        <PropertyGroup Title="Type"><ObjectRow Name="Mode" Value="@IoFieldTexts.Mode(f.Mode)" Control="ObjectRowControl.Combo" /></PropertyGroup>
                    </div>
                    <div class="object-column">
                        <PropertyGroup Title="Format">
                            <ObjectRow Name="Display format" Value="@IoFieldTexts.Format(f.DisplayFormat)" Control="ObjectRowControl.Combo" />
                            <ObjectRow Name="Decimal places" Value="@IoFieldTexts.DecimalPlaces(f)" Control="ObjectRowControl.Spin"
                                       Disabled="!IoFieldTexts.DecimalPlacesEnabled(f)" />
                            <ObjectRow Name="Field length" Value="@IoFieldTexts.FieldLength(f)" Control="ObjectRowControl.Spin"
                                       Disabled="!IoFieldTexts.FieldLengthEnabled(f)" />
                            <ObjectRow Name="Leading zeros" Value="@(f.LeadingZeros ? "Yes" : "No")" Checked="f.LeadingZeros" />
                            <ObjectRow Name="Format pattern" Value="@IoFieldTexts.Pattern(f)" Control="ObjectRowControl.Combo" />
                        </PropertyGroup>
                    </div>
                </div>
                break;
            case General:
                <PropertyGroup Title="General">
                    <ObjectRow Name="Name" Value="Object.Name" />
                    <ObjectRow Name="Таблица" Value="Object.Table" />
                </PropertyGroup>
                break;
            case Appearance when Field is { } f:
                <div class="object-blocks">
                    <div class="object-column">
                        <PropertyGroup Title="Background">
                            <ObjectRow Name="Color" Value="RgbText.Cell(f.Fill.ColorRgb)" Control="ObjectRowControl.Combo" />
                            <ObjectRow Name="Corner radius" Value="f.Border.CornerRadius" Control="ObjectRowControl.Spin" />
                        </PropertyGroup>
                        <PropertyGroup Title="Text">
                            <ObjectRow Name="Color" Value="RgbText.Cell(f.Text.ColorRgb)" Control="ObjectRowControl.Combo" />
                            <ObjectRow Name="Unit" Value="f.Unit" />
                        </PropertyGroup>
                    </div>
                    <div class="object-column">
                        <PropertyGroup Title="Border">
                            <ObjectRow Name="Width" Value="f.Border.Width" Control="ObjectRowControl.Spin" />
                            <ObjectRow Name="Style" Value="@IoFieldTexts.EdgeStyle(f.Border.EdgeStyle)" Control="ObjectRowControl.Combo" />
                            <ObjectRow Name="Color" Value="RgbText.Cell(f.Border.ColorRgb)" Control="ObjectRowControl.Combo" />
                            <ObjectRow Name="Background color" Value="RgbText.Cell(f.Border.BackColorRgb)" Control="ObjectRowControl.Combo" />
                        </PropertyGroup>
                    </div>
                </div>
                break;
            case Characteristics when Field is { } f:
                <PropertyGroup Title="Field" Class="wide">
                    <ObjectRow Name="Hidden input" Value="@(f.HiddenInput ? "Yes" : "No")" Checked="f.HiddenInput" />
                </PropertyGroup>
                break;
            case Limits when Field is { Limits: null }:
                <div class="muted">@IoFieldTexts.LimitsAbsent</div>
                break;
            case Limits when Field is { Limits: { } l }:
                <PropertyGroup Title="Colors" Class="wide">
                    <ObjectRow Name="High limit violated" Value="@IoFieldTexts.LimitColor(l.AboveUpperRgb)" Control="ObjectRowControl.Combo" />
                    <ObjectRow Name="Low limit violated" Value="@IoFieldTexts.LimitColor(l.BelowLowerRgb)" Control="ObjectRowControl.Combo" />
                </PropertyGroup>
                break;
            case Security when Field is { } f:
                <PropertyGroup Title="Runtime security" Class="wide">
                    <ObjectRow Name="Authorization" Value="@IoFieldTexts.Authorization(f.Authorization)" />
                </PropertyGroup>
                <PropertyGroup Title="Operator control" Class="wide operator-control">
                    <ObjectRow Name="Allow operator control" Value="@(f.AllowOperatorControl ? "Yes" : "No")" Checked="f.AllowOperatorControl" />
                </PropertyGroup>
                break;
            case Layout when Field is { } f:
                <div class="object-blocks">
                    <div class="object-column">@PositionAndSize(null)</div>
                    <div class="object-column">
                        <PropertyGroup Title="Margins">
                            <ObjectRow Name="Left" Value="@IoFieldTexts.Margin(f.Text.Margins?.Left)" Control="ObjectRowControl.Spin" />
                            <ObjectRow Name="Right" Value="@IoFieldTexts.Margin(f.Text.Margins?.Right)" Control="ObjectRowControl.Spin" />
                            <ObjectRow Name="Top" Value="@IoFieldTexts.Margin(f.Text.Margins?.Top)" Control="ObjectRowControl.Spin" />
                            <ObjectRow Name="Bottom" Value="@IoFieldTexts.Margin(f.Text.Margins?.Bottom)" Control="ObjectRowControl.Spin" />
                        </PropertyGroup>
                    </div>
                </div>
                break;
            case Layout:
                @PositionAndSize("wide")
                break;
            case Flashing when Field is { } f:
                <PropertyGroup Title="Flashing" Class="wide">
                    <ObjectRow Name="Flashing" Value="@IoFieldTexts.Flashing(f)" Control="ObjectRowControl.Combo" />
                </PropertyGroup>
                break;
            case Miscellaneous when Field is not null:
                <PropertyGroup Title="Tooltip" Class="wide">
                    <div class="object-field tooltip-field">
                        <RadzenTextArea Value="@Tooltip" ReadOnly="true" class="tooltip-text" />
                    </div>
                </PropertyGroup>
                break;
            case TextFormat when Field is { } f:
                <div class="object-blocks">
                    <div class="object-column">
                        <PropertyGroup Title="Format"><ObjectRow Name="Font" Value="@IoFieldTexts.Font(f.Font)" /></PropertyGroup>
                    </div>
                    <div class="object-column">
                        <PropertyGroup Title="Alignment">
                            <ObjectRow Name="Horizontal" Value="@IoFieldTexts.Horizontal(f.Text.HorizontalAlignment)" Control="ObjectRowControl.Combo" />
                            <ObjectRow Name="Vertical" Value="@IoFieldTexts.Vertical(f.Text.VerticalAlignment)" Control="ObjectRowControl.Combo" />
                        </PropertyGroup>
                    </div>
                </div>
                break;
            default:
                <div class="muted">@NotParsed</div>
                break;
        }
    </div>
</div>

@code {
    /// <summary>Раздел General.</summary>
    private const string General = "General";

    /// <summary>Раздел Appearance.</summary>
    private const string Appearance = "Appearance";

    /// <summary>Раздел Layout.</summary>
    private const string Layout = "Layout";

    /// <summary>Раздел Text format.</summary>
    private const string TextFormat = "Text format";

    /// <summary>Раздел Characteristics.</summary>
    private const string Characteristics = "Characteristics";

    /// <summary>Раздел Limits.</summary>
    private const string Limits = "Limits";

    /// <summary>Раздел Flashing.</summary>
    private const string Flashing = "Flashing";

    /// <summary>Раздел Miscellaneous.</summary>
    private const string Miscellaneous = "Miscellaneous";

    /// <summary>Раздел Security.</summary>
    private const string Security = "Security";

    /// <summary>Текст раздела, свойства которого программа не читает.</summary>
    private const string NotParsed = "Не разобрано";

    /// <summary>Разделы I/O field в Property list TIA, в его порядке (решение пользователя 2026-11-02: все разделы).</summary>
    private static readonly string[] FieldSections =
        [General, Appearance, Characteristics, Layout, TextFormat, Flashing, Limits, "Styles/Designs", Miscellaneous, Security];

    /// <summary>Разделы объекта другого типа: известны только имя, таблица и положение.</summary>
    private static readonly string[] ObjectSections = [General, Layout];

    /// <summary>
    /// Выбранный раздел; <c>null</c> или раздела нет у объекта — первый. Хранит панель свойств: при щелчке по другому
    /// объекту раздел остаётся, как в TIA (компонент при смене объекта создаётся заново).
    /// </summary>
    [Parameter]
    public string? Section { get; set; }

    /// <summary>Щелчок по разделу в Property list: панель свойств запоминает его.</summary>
    [Parameter]
    public EventCallback<string> SectionChanged { get; set; }

    /// <summary>PLC tag тега поля с листа «Теги» (<see cref="TagCell"/>): ищется при смене параметров, а не при каждой отрисовке.</summary>
    private ReportCell _plcTag = "";

    /// <summary>Address тега поля с листа «Теги» (<see cref="TagCell"/>).</summary>
    private ReportCell _address = "";

    /// <summary>Объект, выбранный на холсте: имя, таблица, положение.</summary>
    [Parameter, EditorRequired]
    public ScreenObject Object { get; set; } = null!;

    /// <summary>I/O field объекта; объект другого типа — <c>null</c>.</summary>
    [Parameter]
    public IoField? Field { get; set; }

    /// <summary>Tooltip I/O field на выбранном языке; подсказки нет или объект другого типа — пусто.</summary>
    [Parameter]
    public string? Tooltip { get; set; }

    /// <summary>
    /// Таблица листа «Теги» открытой панели (с данными ПЛК, если их выбрали): из неё PLC tag и Address тега поля;
    /// раздел не построен или панели нет — <c>null</c>.
    /// </summary>
    [Parameter]
    public ReportTable? Tags { get; set; }

    /// <summary>Найти PLC tag и Address тега поля на листе «Теги» один раз на смену объекта или листа.</summary>
    protected override void OnParametersSet()
    {
        var row = TagRow();
        (_plcTag, _address) = (TagCell(row, TagsTable.PlcTagColumn), TagCell(row, TagsTable.AddressColumn));
    }

    /// <summary>Блок Position &amp; size: один на I/O field и другие объекты.</summary>
    /// <param name="blockClass">CSS-класс блока (<c>wide</c> — единственный блок раздела) или <c>null</c>.</param>
    /// <returns>Разметка блока.</returns>
    private RenderFragment PositionAndSize(string? blockClass) =>
        @<PropertyGroup Title="Position & size" Class="@blockClass">
            <ObjectRow Name="X" Value="Object.Bounds.Left" Control="ObjectRowControl.Spin" />
            <ObjectRow Name="Y" Value="Object.Bounds.Top" Control="ObjectRowControl.Spin" />
            <ObjectRow Name="Width" Value="Object.Bounds.Width" Control="ObjectRowControl.Spin" />
            <ObjectRow Name="Height" Value="Object.Bounds.Height" Control="ObjectRowControl.Spin" />
        </PropertyGroup>;

    /// <summary>Строка тега поля на листе «Теги» — по колонке Name.</summary>
    /// <returns>Ячейки строки; листа, колонки или тега на листе нет — <c>null</c>.</returns>
    private ReportCell[]? TagRow()
    {
        var name = Tags?.Columns.ToList().IndexOf(TagsTable.NameColumn) ?? -1;
        return name < 0 || Field?.Tag is not { } tag ? null : Tags!.Rows.FirstOrDefault(r => r[name].Display == tag);
    }

    /// <summary>
    /// Ячейка строки тега поля на листе «Теги» в колонке <paramref name="column"/> — то же, что на листе (решение
    /// пользователя 2026-11-03): с данными ПЛК — тег ПЛК и адрес, без них — что известно из панели.
    /// </summary>
    /// <returns>Ячейка; тега нет на листе, листа или колонки нет — пустая.</returns>
    private ReportCell TagCell(ReportCell[]? row, string column)
    {
        var index = Tags?.Columns.ToList().IndexOf(column) ?? -1;
        return row is not null && index >= 0 ? row[index] : "";
    }

    /// <summary>Разделы слева: у I/O field — все разделы TIA, у другого объекта — General и Layout.</summary>
    /// <returns>Имена разделов.</returns>
    private string[] Sections() => Field is null ? ObjectSections : FieldSections;

    /// <summary>Показываемый раздел: выбранный, если он есть у объекта, иначе первый.</summary>
    /// <returns>Имя раздела.</returns>
    private string Current() => Sections().Contains(Section) ? Section! : Sections()[0];
}
