@using FlexRt.Export.ScreenEvents
@using FlexRt.Model.Panel.Screens

@switch (Tab)
{
    case "Animations" when Field is not null || Button is not null:
        <ObjectAnimations AnimatedAppearance="@(Field?.Appearance ?? Button?.AnimatedAppearance)"
                          Conditions="@(Field?.Conditions ?? Button?.Conditions ?? [])"
                          Movements="@(Field?.Movements ?? Button?.Movements ?? [])"
                          ProcessTag="@AnimationTag()" Subject="@(Field is null ? "кнопки" : "поля")" />
        break;
    case "Texts" when Field is not null && Tooltips is not null:
        <IoFieldTextTable Texts="@Tooltips.Texts(Field.Element)" ObjectName="@ObjectName" />
        break;
    case EventsTab when Field is { Mode: IoFieldMode.Output } && Events is not null:
        <div class="muted">@IoFieldTexts.OutputEventsAbsent</div>
        break;
    case EventsTab when Events is not null:
        <ScreenEvents Events="Events" />
        break;
    default:
        <div class="muted">Не разобрано</div>
        break;
}

@code {
    /// <summary>Вкладка Events поля или кнопки.</summary>
    private const string EventsTab = "Events";

    /// <summary>
    /// Вкладка объекта: Animations и Events у Button, Animations, Events и Texts у I/O field.
    /// </summary>
    [Parameter]
    public string Tab { get; set; } = "";

    /// <summary>I/O field выбранного объекта; объект другого типа — <c>null</c>.</summary>
    [Parameter]
    public IoField? Field { get; set; }

    /// <summary>Кнопка выбранного объекта; другой тип — null.</summary>
    [Parameter]
    public ButtonGeneral? Button { get; set; }

    /// <summary>Тег селектора списка кнопки.</summary>
    [Parameter]
    public string ProcessTag { get; set; } = "";

    /// <summary>Имя выбранного объекта для Reference вкладки Texts.</summary>
    [Parameter]
    public string ObjectName { get; set; } = "";

    /// <summary>Подсказки объектов на языках Runtime для вкладки Texts поля.</summary>
    [Parameter]
    public ScreenObjectTooltips? Tooltips { get; set; }

    /// <summary>События поля или кнопки для инспектора; нет — <c>null</c>.</summary>
    [Parameter]
    public IReadOnlyList<ScreenEventView>? Events { get; set; }

    /// <summary>Взять тег значения поля или прочитанный селектор списка кнопки.</summary>
    /// <returns>Отображаемый тег; null, если связь кнопки отсутствует.</returns>
    private string? AnimationTag()
    {
        if (Field is { } field)
        {
            return field.Tag ?? (field.TagVia is { } via ? $"? ({via})" : "");
        }
        return Button is { Mode: ButtonMode.TextList or ButtonMode.GraphicList, List: not null } ? ProcessTag : null;
    }
}
