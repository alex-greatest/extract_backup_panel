@using FlexRt.Model.Panel.Screens
@using FlexRt.Ui.Components.Inspector.Objects

@if (Button.Mode == ButtonMode.Invisible)
{
    <PositionAndSizeProperties Bounds="Bounds" Class="wide" />
}
else
{
    var normal = Button.Appearance?.Normal;
    var picture = normal?.Picture;
    <div class="object-blocks button-layout">
        <div class="object-column">
            <PositionAndSizeProperties Bounds="Bounds" Class="button-layout-grid" />
            <PropertyGroup Title="Fit graphic to size">
                <div role="radiogroup" aria-label="Fit graphic to size">
                    @PictureSizingOption("No stretching of graphic", Button.StretchPicture == false)
                    @PictureSizingOption("Stretch graphic", Button.StretchPicture == true)
                </div>
            </PropertyGroup>
            <PropertyGroup Title="Alignment graphic">
                <ObjectRow Name="Horizontal" Value="@Horizontal(picture)" Disabled="@(!HasPicture)" />
                <ObjectRow Name="Vertical" Value="@Vertical(picture)" Disabled="@(!HasPicture)" />
            </PropertyGroup>
        </div>
        <div class="object-column">
            <PropertyGroup Title="Fit to size">
                <div class="button-fit-unknown">
                    <span class="button-fit-mark" role="checkbox" aria-label="Fit object to contents"
                          aria-checked="mixed" aria-disabled="true">−</span>
                    <span>Fit object to contents</span>
                    <span class="button-fit-note">Не определено по FWC</span>
                </div>
            </PropertyGroup>
            <PropertyGroup Title="Text margins" Class="button-layout-grid">
                @{ var text = normal?.Text?.Margins; }
                @Margins(text?.Left, text?.Right, text?.Top, text?.Bottom, !HasText)
            </PropertyGroup>
            <PropertyGroup Title="Picture margins" Class="button-layout-grid">
                @{ var margins = picture?.Margins; }
                @Margins(margins?.Left, margins?.Right, margins?.Top, margins?.Bottom, !HasPicture)
            </PropertyGroup>
        </div>
    </div>
}

@code {
    /// <summary>Прочитанные свойства выбранной кнопки.</summary>
    [Parameter, EditorRequired]
    public ButtonGeneral Button { get; set; } = null!;

    /// <summary>Положение и размер кнопки.</summary>
    [Parameter, EditorRequired]
    public ScreenRect Bounds { get; set; }

    /// <summary>Режим содержит текстовую подпись.</summary>
    private bool HasText => Button.Mode is ButtonMode.Text or ButtonMode.TextList or ButtonMode.GraphicAndText;

    /// <summary>Режим содержит графическую подпись.</summary>
    private bool HasPicture => Button.Mode is ButtonMode.Graphic or ButtonMode.GraphicList or ButtonMode.GraphicAndText;

    /// <summary>Показать вариант подгонки графической подписи только для чтения.</summary>
    /// <returns>Переключатель с состоянием из файла.</returns>
    private RenderFragment PictureSizingOption(string label, bool selected) =>
        @<div class="anim-radio @(selected ? "checked" : "") @(HasPicture ? "" : "disabled")"
              role="radio" aria-checked="@(selected ? "true" : "false")" aria-disabled="true">
            <span class="anim-radio-box" aria-hidden="true"></span>@label
        </div>;

    /// <summary>Горизонтальное выравнивание картинки.</summary>
    /// <returns>Right, Center, Left или сообщение о непрочитанном значении.</returns>
    private static string Horizontal(ButtonPictureLayout? picture) => picture?.HorizontalAlignment switch
    {
        0 => "Right",
        1 => "Center",
        2 => "Left",
        _ => "не прочитано"
    };

    /// <summary>Вертикальное выравнивание картинки.</summary>
    /// <returns>Top, Middle, Bottom или сообщение о непрочитанном значении.</returns>
    private static string Vertical(ButtonPictureLayout? picture) => picture?.VerticalAlignment switch
    {
        0 => "Top",
        1 => "Middle",
        2 => "Bottom",
        _ => "не прочитано"
    };

    /// <summary>Показать четыре отступа текста или картинки в двух столбцах.</summary>
    /// <returns>Строки свойств.</returns>
    private static RenderFragment Margins(int? left, int? right, int? top, int? bottom, bool disabled) =>
        @<text>
            <ObjectRow Name="Left" Value="@Margin(left)" Control="ObjectRowControl.Spin" Disabled="disabled" />
            <ObjectRow Name="Right" Value="@Margin(right)" Control="ObjectRowControl.Spin" Disabled="disabled" />
            <ObjectRow Name="Top" Value="@Margin(top)" Control="ObjectRowControl.Spin" Disabled="disabled" />
            <ObjectRow Name="Bottom" Value="@Margin(bottom)" Control="ObjectRowControl.Spin" Disabled="disabled" />
        </text>;

    /// <summary>Число поля или сообщение о непрочитанном значении.</summary>
    /// <returns>Ячейка свойства.</returns>
    private static ReportCell Margin(int? value) => (ReportCell?)value ?? "—";
}
