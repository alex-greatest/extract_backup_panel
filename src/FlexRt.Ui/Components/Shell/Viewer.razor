@using System.IO
@inject NotificationService Notifications

<div class="shell">
    <Toolbar Loading="_loading" PlcPath="@_plcPath" OnOpen="OpenAsync" OnPlc="ChoosePlcAsync" />

    <RadzenSplitter class="workspace">
        <RadzenSplitterPane Size="300px" Min="150px" Max="700px">
            <section class="pane">
                <header class="pane-title">Дерево проекта</header>
                <div class="tree-scroll">
                    <ProjectTree Loading="_loading" FileName="@FileName()" View="_view" Screens="_screens" Selected="_selected" OnSelect="Select" />
                </div>
            </section>
        </RadzenSplitterPane>
        <RadzenSplitterPane>
            <RadzenSplitter Orientation="Orientation.Vertical" class="editor-split">
                <RadzenSplitterPane Size="calc(100% - 340px)" Min="150px">
                    <section class="pane">
                        @if (_selected is PanelSection section)
                        {
                            <SectionView Title="@Breadcrumb()" Section="section" SelectedRow="_row" OnRowSelect="SelectRow"
                                         OnCountChanged="count => _rowCount = count" OnCopyFailed="text => _notice = text" />
                        }
                        else
                        {
                            <ScreenCanvas Title="@Breadcrumb()" Item="@(_selected as ScreenItem)" />
                        }
                    </section>
                </RadzenSplitterPane>
                <RadzenSplitterPane Min="120px">
                    <section class="pane">
                        <PropertiesPanel Item="@(_selected as ScreenItem)" Row="@InspectedRow()" Hint="@InspectorHint()" Lines="_lines" />
                    </section>
                </RadzenSplitterPane>
            </RadzenSplitter>
        </RadzenSplitterPane>
    </RadzenSplitter>

    <StatusBar Loading="_loading" Path="@_path" Error="@_error" ScreenCount="_screenCount" WarningCount="@_lines.Count(l => l.Level != TranscriptLevel.Info)"
               RowCount="@(ShownTable() is null ? null : _rowCount)" RowTotal="@ShownTable()?.Rows.Count" Notice="@_notice" />
    <RadzenNotification />
</div>

@code {
    /// <summary>Сколько миллисекунд висит уведомление об ошибках после открытия.</summary>
    private const double NotificationDuration = 6000;

    /// <summary>Подсказка в панели свойств, когда открыта таблица, а строка не выбрана.</summary>
    private const string NoRowHint = "Выберите строку таблицы";

    /// <summary>Подсказка в панели свойств для раздела, таблицу которого построить не удалось.</summary>
    private const string FailedHint = "Таблица раздела не построена — причина на вкладке Info";

    /// <summary>Подсказка в панели свойств для «Сводки»: у неё нет строк со свойствами.</summary>
    private const string SummaryHint = "У «Сводки» нет свойств строк";

    /// <summary>Путь открытого или открываемого файла; <c>null</c> — файл ещё не выбирали.</summary>
    private string? _path;

    /// <summary>Экраны открытой панели в порядке листа «Экраны».</summary>
    private IReadOnlyList<ScreenItem> _screens = [];

    /// <summary>Разделы открытой панели; <c>null</c> — панель не открыта.</summary>
    private PanelView? _view;

    /// <summary>Число обычных экранов (вида Screen) — то же, что строка «Экранов» на вкладке Info и на «Сводке».</summary>
    private int _screenCount;

    /// <summary>
    /// Строки вкладки Info: текст чтения панели и данных ПЛК (<see cref="RunTranscript"/> — то, что раньше печатала
    /// консоль) и предупреждения о разделах, которые не построены.
    /// </summary>
    private IReadOnlyList<TranscriptLine> _lines = [];

    /// <summary>Выбранные данные ПЛК: файл <c>PEData.plf</c> или папка карты ПЛК; <c>null</c> — не заданы.</summary>
    private string? _plcPath;

    /// <summary>Выбранный в дереве узел: экран (<see cref="ScreenItem"/>) или раздел (<see cref="PanelSection"/>); <c>null</c> — ничего.</summary>
    private object? _selected;

    /// <summary>Выбранная строка таблицы раздела (номер в листе с нуля); <c>null</c> — не выбрана.</summary>
    private int? _row;

    /// <summary>Строк таблицы раздела после фильтра.</summary>
    private int _rowCount;

    /// <summary>Сообщение об ошибке действия в окне для строки состояния; <c>null</c> — нет.</summary>
    private string? _notice;

    /// <summary>Текст ошибки чтения файла; <c>null</c> — ошибки нет.</summary>
    private string? _error;

    /// <summary>Идёт чтение файла: кнопка открытия занята.</summary>
    private bool _loading;

    /// <summary>Выбрать файл диалогом и прочитать его (<see cref="LoadAsync"/>). Отмена диалога ничего не меняет.</summary>
    private async Task OpenAsync()
    {
        var chosen = PanelFileDialog.Ask();
        if (chosen is null)
        {
            return;
        }
        _path = chosen;
        await LoadAsync();
    }

    /// <summary>
    /// Пункт меню данных ПЛК: файл <c>PEData.plf</c> или папка карты — диалогом, «Без данных ПЛК» — сброс. Открытая панель
    /// перечитывается с новым выбором. Отмена диалога ничего не меняет.
    /// </summary>
    private async Task ChoosePlcAsync(string? item)
    {
        var chosen = item switch
        {
            Toolbar.PlcFile => PlcDataDialog.AskFile(),
            Toolbar.PlcCard => PlcDataDialog.AskCardFolder(),
            _ => null
        };
        if (chosen is null && item != Toolbar.PlcNone)
        {
            return;
        }
        _plcPath = chosen;
        if (_path is not null)
        {
            await LoadAsync();
        }
    }

    /// <summary>
    /// Прочитать файл <see cref="_path"/> с данными ПЛК <see cref="_plcPath"/>, если они выбраны (<see cref="PanelLoader.LoadAsync"/>:
    /// тяжёлые шаги — вне потока окна). Успех — экраны, разделы и строки Info, выбран стартовый экран, а если его нет —
    /// первый. Прежняя панель убирается сразу, до чтения, чтобы во время чтения не показывать смесь старого и нового
    /// файла. Сбой — панель не показывается, ошибка в строке состояния и на Info.
    /// </summary>
    private async Task LoadAsync()
    {
        var path = _path!;
        var plcPath = _plcPath;
        _loading = true;
        _error = null;
        ClearPanel();
        try
        {
            var panel = await PanelLoader.LoadAsync(path, plcPath);
            _screens = panel.Screens;
            _view = panel.View;
            _screenCount = panel.ScreenCount;
            _lines = panel.Lines;
            _error = panel.Error;
            _selected = _screens.FirstOrDefault(s => s.IsStart) ?? _screens.FirstOrDefault();
            NotifyProblems();
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Всплывающее уведомление после открытия, если на вкладке «Ошибки» что-то есть (решение пользователя): красное
    /// «Есть ошибки», если есть хоть одна ошибка, иначе жёлтое «Есть предупреждения»; число — всех строк вкладки.
    /// </summary>
    private void NotifyProblems()
    {
        var problems = _lines.Count(l => l.Level != TranscriptLevel.Info);
        if (problems == 0)
        {
            return;
        }
        var hasErrors = _lines.Any(l => l.Level == TranscriptLevel.Error);
        Notifications.Notify(hasErrors ? NotificationSeverity.Error : NotificationSeverity.Warning,
            hasErrors ? "Есть ошибки" : "Есть предупреждения", $"{problems} — вкладка «Ошибки»", NotificationDuration);
    }

    /// <summary>Убрать данные открытой панели: экраны, разделы, их числа, строки Info и выбор.</summary>
    private void ClearPanel()
    {
        _screens = [];
        _view = null;
        _screenCount = 0;
        _lines = [];
        _selected = null;
        _row = null;
        _notice = null;
    }

    /// <summary>
    /// Выбрать узел дерева: экран или раздел. У раздела с таблицей выбирается первая строка, число строк — все строки
    /// таблицы, пока таблица не сообщит своё. Повторный выбор показанного узла (дерево сообщает его после щелчка по
    /// папке) ничего не меняет: таблица того же раздела не пересоздаётся и хранит свои фильтр, сортировку и выбор.
    /// </summary>
    private void Select(object node)
    {
        if (ReferenceEquals(node, _selected))
        {
            return;
        }
        _selected = node;
        _notice = null;
        var table = ShownTable();
        _row = table is { Rows.Count: > 0 } ? 0 : null;
        _rowCount = table?.Rows.Count ?? 0;
    }

    /// <summary>Выбрать строку таблицы раздела; <c>null</c> — снять выбор (фильтр скрыл строку).</summary>
    private void SelectRow(int? row)
    {
        _row = row;
        _notice = null;
    }

    /// <summary>Таблица выбранного раздела; экран, «Сводка», раздел без таблицы или ничего не выбрано — <c>null</c>.</summary>
    /// <returns>Таблица листа или <c>null</c>.</returns>
    private ReportTable? ShownTable() => _selected is PanelSection { IsSummary: false, Error: null } section ? section.Table : null;

    /// <summary>Строка для панели свойств: выбранная строка таблицы раздела.</summary>
    /// <returns>Строка; не выбрана или открыт не раздел — <c>null</c>.</returns>
    private SectionRow? InspectedRow() => _selected is PanelSection section && _row is { } row ? new SectionRow(section, row) : null;

    /// <summary>Подсказка панели свойств для раздела без выбранной строки.</summary>
    /// <returns>Текст подсказки; открыт экран или выбрана строка — <c>null</c>.</returns>
    private string? InspectorHint() => _selected switch
    {
        PanelSection { Error: not null } => FailedHint,
        PanelSection { IsSummary: true } => SummaryHint,
        PanelSection when _row is null => NoRowHint,
        _ => null
    };

    /// <summary>Имя открытого файла для корня дерева.</summary>
    /// <returns>Имя файла; файл не открыт или не прочитан — <c>null</c>.</returns>
    private string? FileName() => _path is null || _error is not null || _loading ? null : Path.GetFileName(_path);

    /// <summary>
    /// Путь в заголовке редактора, как в TIA: <c>pdata.fwc ▸ Screen ▸ Root screen</c> у экрана,
    /// <c>pdata.fwc ▸ HMI alarms ▸ Discrete alarms</c> у раздела.
    /// </summary>
    /// <returns>Текст строки; ничего не выбрано — пусто.</returns>
    private string Breadcrumb() => (_selected, _path) switch
    {
        (ScreenItem item, not null) => $"{Path.GetFileName(_path)}  ▸  {item.Kind}  ▸  {item.Name}",
        (PanelSection section, not null) => $"{Path.GetFileName(_path)}  ▸  {section.Path}",
        _ => ""
    };
}
