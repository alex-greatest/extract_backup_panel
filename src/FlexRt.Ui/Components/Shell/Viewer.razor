@using System.IO
@inject NotificationService Notifications
@inject PictureSelection Pictures

<div class="shell">
    <Toolbar Loading="_loading" PlcPath="@_plcPath" OnOpen="OpenAsync" OnPlc="ChoosePlcAsync"
             CanSave="@(_view is not null && !_loading && !_saving)" CanSaveSheet="@(_view is not null && PanelDataSheets.IsSheet(_view, _selected))"
             CanSavePictures="@(_view is not null && !_loading && !_saving && Pictures.Pictures.Items.Count > 0)"
             CanSavePicture="@(Pictures.Selected is not null)" OnSave="SaveAsync" />

    <RadzenSplitter class="workspace">
        <RadzenSplitterPane Size="300px" Min="150px" Max="700px">
            <section class="pane">
                <header class="pane-title">Дерево проекта</header>
                <div class="tree-scroll">
                    <ProjectTree Loading="_loading" FileName="@FileName()" View="_view" Screens="_screens" Pictures="Pictures.Pictures" Selected="_selected" OnSelect="Select" />
                </div>
            </section>
        </RadzenSplitterPane>
        <RadzenSplitterPane>
            <RadzenSplitter Orientation="Orientation.Vertical" class="editor-split">
                <RadzenSplitterPane Size="calc(100% - 360px)" Min="150px">
                    <section class="pane">
                        @switch (_selected)
                        {
                            case PanelSection section:
                                <SectionView Title="@EditorPath.Of(_selected, _path)" Section="section" SelectedRow="_row" OnRowSelect="SelectRow"
                                             OnCountChanged="count => _rowCount = count" OnCopyFailed="text => _notice = text" />
                                break;
                            case PanelPictures pictures:
                                <PictureGallery Title="@EditorPath.Of(_selected, _path)" Pictures="pictures" Selected="Pictures.Selected" OnSelect="SelectPicture" OnOpen="Pictures.Open" />
                                break;
                            default:
                                <ScreenCanvas Title="@EditorPath.Of(_selected, _path)" Item="@(_selected as ScreenItem)" Empty="@(NoPanelHint() ?? Hints.NoScreen)" />
                                break;
                        }
                    </section>
                </RadzenSplitterPane>
                <RadzenSplitterPane Min="120px">
                    <section class="pane">
                        <PropertiesPanel Item="@(_selected as ScreenItem)" Row="@InspectedRow()" Picture="Pictures.Selected" Hint="@InspectorHint()" Lines="_lines" OnOpenPicture="Pictures.Open" />
                    </section>
                </RadzenSplitterPane>
            </RadzenSplitter>
        </RadzenSplitterPane>
    </RadzenSplitter>

    <StatusBar Loading="_loading" Path="@_path" Error="@_error" ScreenCount="_screenCount" WarningCount="@_lines.Count(l => l.Level != TranscriptLevel.Info)"
               RowCount="@(ShownTable() is null ? null : _rowCount)" RowTotal="@ShownTable()?.Rows.Count" Notice="@_notice" />
    <PictureViewer Pictures="Pictures.Pictures" Current="Pictures.Shown" OnShow="SelectPicture" OnClose="Pictures.Close" />
    <RadzenNotification />
</div>

@code {
    /// <summary>Сколько миллисекунд висит уведомление об ошибках после открытия.</summary>
    private const double NotificationDuration = 6000;

    /// <summary>Путь открытого или открываемого файла; <c>null</c> — файл ещё не выбирали.</summary>
    private string? _path;

    /// <summary>Экраны открытой панели в порядке листа «Экраны».</summary>
    private IReadOnlyList<ScreenItem> _screens = [];

    /// <summary>Разделы открытой панели; <c>null</c> — панель не открыта.</summary>
    private PanelView? _view;

    /// <summary>Число обычных экранов (вида Screen) — то же, что строка «Экранов» на вкладке Info и на «Сводке».</summary>
    private int _screenCount;

    /// <summary>
    /// Строки вкладки Info: текст чтения панели и данных ПЛК (<see cref="RunTranscript"/> — то, что раньше печатала
    /// консоль) и предупреждения о разделах, которые не построены.
    /// </summary>
    private IReadOnlyList<TranscriptLine> _lines = [];

    /// <summary>Строки языков открытой панели — для сохранения <c>PDATA.xlsx</c>.</summary>
    private IReadOnlyList<LangString> _strings = [];

    /// <summary>Сохранение книг Excel и картинок; помнит папку последнего сохранения до закрытия окна.</summary>
    private readonly PanelSaver _saver = new();

    /// <summary>Идёт сохранение: кнопки сохранения заняты.</summary>
    private bool _saving;

    /// <summary>Выбранные данные ПЛК: файл <c>PEData.plf</c> или папка карты ПЛК; <c>null</c> — не заданы.</summary>
    private string? _plcPath;

    /// <summary>
    /// Выбранный в дереве узел: экран (<see cref="ScreenItem"/>), раздел (<see cref="PanelSection"/>) или картинки
    /// (<see cref="PanelPictures"/>); <c>null</c> — ничего.
    /// </summary>
    private object? _selected;

    /// <summary>Выбранная строка таблицы раздела (номер в листе с нуля); <c>null</c> — не выбрана.</summary>
    private int? _row;

    /// <summary>Строк таблицы раздела после фильтра.</summary>
    private int _rowCount;

    /// <summary>Сообщение об ошибке действия в окне для строки состояния; <c>null</c> — нет.</summary>
    private string? _notice;

    /// <summary>Текст ошибки чтения файла; <c>null</c> — ошибки нет.</summary>
    private string? _error;

    /// <summary>Идёт чтение файла: кнопка открытия занята.</summary>
    private bool _loading;

    /// <summary>Выбрать файл диалогом и прочитать его (<see cref="LoadAsync"/>). Отмена диалога ничего не меняет.</summary>
    private async Task OpenAsync()
    {
        var chosen = PanelFileDialog.Ask();
        if (chosen is null)
        {
            return;
        }
        _path = chosen;
        await LoadAsync();
    }

    /// <summary>
    /// Пункт меню данных ПЛК: файл <c>PEData.plf</c> или папка карты — диалогом, «Без данных ПЛК» — сброс. Открытая панель
    /// перечитывается с новым выбором. Отмена диалога ничего не меняет.
    /// </summary>
    private async Task ChoosePlcAsync(string? item)
    {
        var chosen = item switch
        {
            Toolbar.PlcFile => PlcDataDialog.AskFile(),
            Toolbar.PlcCard => PlcDataDialog.AskCardFolder(),
            _ => null
        };
        if (chosen is null && item != Toolbar.PlcNone)
        {
            return;
        }
        _plcPath = chosen;
        if (_path is not null)
        {
            await LoadAsync();
        }
    }

    /// <summary>
    /// Прочитать файл <see cref="_path"/> с данными ПЛК <see cref="_plcPath"/>, если они выбраны (<see cref="PanelLoader.LoadAsync"/>:
    /// тяжёлые шаги — вне потока окна). Успех — экраны, разделы и строки Info, выбран стартовый экран, а если его нет —
    /// первый. Прежняя панель убирается сразу, до чтения, чтобы во время чтения не показывать смесь старого и нового
    /// файла. Сбой — панель не показывается, ошибка в строке состояния и на Info.
    /// </summary>
    private async Task LoadAsync()
    {
        var path = _path!;
        var plcPath = _plcPath;
        _loading = true;
        _error = null;
        ClearPanel();
        try
        {
            var panel = await PanelLoader.LoadAsync(path, plcPath);
            _screens = panel.Screens;
            Pictures.Load(panel.Pictures);
            _view = panel.View;
            _strings = panel.Strings;
            _screenCount = panel.ScreenCount;
            _lines = panel.Lines;
            _error = panel.Error;
            _selected = _screens.FirstOrDefault(s => s.IsStart) ?? _screens.FirstOrDefault();
            NotifyProblems();
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Пункт сохранения (<see cref="PanelSaver"/>): вся книга данных панели, текущий лист, книга текстов, выбранная картинка или
    /// все картинки архивом. Итог — уведомлением (успех — зелёное, не всё или нечего — жёлтое, ошибка — красное); ошибка записи —
    /// ещё и в строке состояния, если за время записи не открыли другой файл. Отмена диалога ничего не меняет.
    /// </summary>
    private async Task SaveAsync(string? item)
    {
        if (_view is not { } view || _path is not { } path)
        {
            return;
        }
        _saving = true;
        try
        {
            var outcome = await _saver.SaveAsync(item, new SaveSources(view, _selected, _strings, Pictures), path);
            if (outcome is not null)
            {
                if (_path == path)
                {
                    _notice = outcome.Severity == NotificationSeverity.Error ? $"{outcome.Summary}: {outcome.Detail}" : null;
                }
                Notifications.Notify(outcome.Severity, outcome.Summary, outcome.Detail, NotificationDuration);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Всплывающее уведомление после открытия, если на вкладке «Ошибки» что-то есть (решение пользователя): красное
    /// «Есть ошибки», если есть хоть одна ошибка, иначе жёлтое «Есть предупреждения»; число — всех строк вкладки.
    /// </summary>
    private void NotifyProblems()
    {
        var problems = _lines.Count(l => l.Level != TranscriptLevel.Info);
        if (problems == 0)
        {
            return;
        }
        var hasErrors = _lines.Any(l => l.Level == TranscriptLevel.Error);
        Notifications.Notify(hasErrors ? NotificationSeverity.Error : NotificationSeverity.Warning,
            hasErrors ? "Есть ошибки" : "Есть предупреждения", $"{problems} — вкладка «Ошибки»", NotificationDuration);
    }

    /// <summary>Убрать данные открытой панели: экраны, картинки, разделы, их числа, строки Info и выбор.</summary>
    private void ClearPanel()
    {
        _screens = [];
        _view = null;
        _strings = [];
        _screenCount = 0;
        _lines = [];
        _selected = null;
        _row = null;
        Pictures.Load(PanelPictures.None);
        _notice = null;
    }

    /// <summary>
    /// Выбрать узел дерева: экран, раздел или картинки. У раздела с таблицей выбирается первая строка, число строк — все
    /// строки таблицы, пока таблица не сообщит своё; у картинок — первая картинка. Повторный выбор показанного узла (дерево сообщает его после щелчка по
    /// папке) ничего не меняет: таблица того же раздела не пересоздаётся и хранит свои фильтр, сортировку и выбор.
    /// </summary>
    private void Select(object node)
    {
        if (ReferenceEquals(node, _selected))
        {
            return;
        }
        _selected = node;
        _notice = null;
        var table = ShownTable();
        _row = table is { Rows.Count: > 0 } ? 0 : null;
        _rowCount = table?.Rows.Count ?? 0;
        Pictures.SelectNode(node is PanelPictures);
    }

    /// <summary>Выбрать картинку щелчком в галерее или листанием на всё окно; ошибка действия снимается, как при выборе строки.</summary>
    private void SelectPicture(PictureItem picture)
    {
        Pictures.Select(picture);
        _notice = null;
    }

    /// <summary>Выбрать строку таблицы раздела; <c>null</c> — снять выбор (фильтр скрыл строку).</summary>
    private void SelectRow(int? row)
    {
        _row = row;
        _notice = null;
    }

    /// <summary>Таблица выбранного раздела; экран, «Сводка», раздел без таблицы или ничего не выбрано — <c>null</c>.</summary>
    /// <returns>Таблица листа или <c>null</c>.</returns>
    private ReportTable? ShownTable() => _selected is PanelSection { IsSummary: false, Error: null } section ? section.Table : null;

    /// <summary>Строка для панели свойств: выбранная строка таблицы раздела.</summary>
    /// <returns>Строка; не выбрана или открыт не раздел — <c>null</c>.</returns>
    private SectionRow? InspectedRow() => _selected is PanelSection section && _row is { } row ? new SectionRow(section, row) : null;

    /// <summary>Подсказка панели свойств: файл не открыт или читается, раздел без выбранной строки, картинки без выбранной.</summary>
    /// <returns>Текст подсказки; открыт экран, выбраны строка или картинка, ничего не выбрано в открытой панели — <c>null</c>.</returns>
    private string? InspectorHint() => _selected switch
    {
        _ when NoPanelHint() is { } hint => hint,
        PanelSection { Error: not null } => Hints.Failed,
        PanelSection { IsSummary: true } => Hints.Summary,
        PanelSection when _row is null => Hints.NoRow,
        PanelPictures when Pictures.Selected is null => Hints.NoPicture,
        _ => null
    };

    /// <summary>Подсказка, пока панели нет: файл читается или не открыт (не прочитан) — как в дереве проекта.</summary>
    /// <returns>Текст подсказки; панель открыта — <c>null</c>.</returns>
    private string? NoPanelHint() => _loading ? Hints.Reading : _view is null ? Hints.NoFile : null;

    /// <summary>Имя открытого файла для корня дерева.</summary>
    /// <returns>Имя файла; файл не открыт или не прочитан — <c>null</c>.</returns>
    private string? FileName() => _path is null || _error is not null || _loading ? null : Path.GetFileName(_path);

}
