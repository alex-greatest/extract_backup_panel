<div class="toolbar">
    <RadzenButton Text="Открыть pdata.fwc…" Icon="folder_open" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                  Size="ButtonSize.Small" Click="@(() => OnOpen.InvokeAsync())" IsBusy="Loading" BusyText="Чтение…" />
    <RadzenSplitButton Text="Данные ПЛК" Icon="memory" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                       AlwaysOpenPopup="true" Disabled="Loading" Click="@(item => OnPlc.InvokeAsync(item.Value))">
        <RadzenSplitButtonItem Text="Файл PEData.plf…" Value="@PlcFile" />
        <RadzenSplitButtonItem Text="Карта ПЛК…" Value="@PlcCard" />
        <RadzenSplitButtonItem Text="Без данных ПЛК" Value="@PlcNone" />
    </RadzenSplitButton>
    <span class="toolbar-note">Данные ПЛК: @(PlcPath ?? "не заданы")</span>
    <RadzenSplitButton Text="Экспортировать все данные" Icon="save" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                       AlwaysOpenPopup="true" Disabled="@(!CanSave)" Click="@(item => OnSave.InvokeAsync(item.Value))">
        <RadzenSplitButtonItem Text="Вся книга…" Value="@SaveItem.Book" />
        <RadzenSplitButtonItem Text="Текущий лист…" Value="@SaveItem.Sheet" Disabled="@(!CanSaveSheet)" />
    </RadzenSplitButton>
    <RadzenButton Text="Экспорт всех текстов…" Icon="save" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                  Disabled="@(!CanSave)" Click="@(() => OnSave.InvokeAsync(SaveItem.Strings))" />
    <RadzenSplitButton Text="Экспорт всех картинок" Icon="image" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                       AlwaysOpenPopup="true" Disabled="@(!CanSavePictures)" Click="@(item => OnSave.InvokeAsync(item.Value))">
        <RadzenSplitButtonItem Text="Выбранная картинка…" Value="@SaveItem.Picture" Disabled="@(!CanSavePicture)" />
        <RadzenSplitButtonItem Text="Все в zip…" Value="@SaveItem.Pictures" />
    </RadzenSplitButton>
</div>

@code {
    /// <summary>Пункт меню данных ПЛК: выбрать файл <c>PEData.plf</c>.</summary>
    public const string PlcFile = "file";

    /// <summary>Пункт меню данных ПЛК: выбрать папку копии карты ПЛК.</summary>
    public const string PlcCard = "card";

    /// <summary>Пункт меню данных ПЛК: отказаться от данных ПЛК.</summary>
    public const string PlcNone = "none";

    /// <summary>Идёт чтение файла: кнопки открытия и данных ПЛК заняты.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Выбранные данные ПЛК: файл или папка карты; <c>null</c> — не заданы.</summary>
    [Parameter]
    public string? PlcPath { get; set; }

    /// <summary>Панель открыта, не читается и не сохраняется: кнопки сохранения доступны.</summary>
    [Parameter]
    public bool CanSave { get; set; }

    /// <summary>В дереве выбран построенный раздел книги данных панели: пункт «Текущий лист…» доступен.</summary>
    [Parameter]
    public bool CanSaveSheet { get; set; }

    /// <summary>Сохранять можно (<see cref="CanSave"/>), и в панели есть картинки: меню «Картинки» доступно.</summary>
    [Parameter]
    public bool CanSavePictures { get; set; }

    /// <summary>В галерее выбрана картинка: пункт «Выбранная картинка…» доступен.</summary>
    [Parameter]
    public bool CanSavePicture { get; set; }

    /// <summary>Щелчок по кнопке открытия файла.</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>Выбран пункт меню данных ПЛК: <see cref="PlcFile"/>, <see cref="PlcCard"/> или <see cref="PlcNone"/>.</summary>
    [Parameter]
    public EventCallback<string?> OnPlc { get; set; }

    /// <summary>Выбран пункт сохранения — значение <see cref="SaveItem"/>.</summary>
    [Parameter]
    public EventCallback<string?> OnSave { get; set; }
}
