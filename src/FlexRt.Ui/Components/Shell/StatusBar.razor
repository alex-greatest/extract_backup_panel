<footer class="statusbar">
    @if (Loading)
    {
        <span class="status-long" title="@Path">Чтение @Path…</span>
    }
    else if (Error is not null)
    {
        <span class="status-long status-error" title="@Error">@Error</span>
    }
    else if (Path is not null)
    {
        <span class="status-long" title="@Path">@Path</span>
        <span class="spacer"></span>
        @if (Notice is not null)
        {
            <span class="status-long status-error" title="@Notice">@Notice</span>
        }
        @if (RowCount is { } shown && RowTotal is { } total)
        {
            <span>Строк: @shown из @total</span>
        }
        <span>Экранов: @ScreenCount</span>
        @if (WarningCount > 0)
        {
            <span class="status-warning">Предупреждений и ошибок: @WarningCount (вкладка «Ошибки»)</span>
        }
    }
    else
    {
        <span>Файл не открыт</span>
    }
</footer>

@code {
    /// <summary>Идёт чтение файла.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Путь открытого или открываемого файла; <c>null</c> — файл ещё не выбирали.</summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>Текст ошибки чтения файла; <c>null</c> — ошибки нет.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Число обычных экранов открытой панели (вида Screen), как строка «Экранов» на вкладке Info и на «Сводке».</summary>
    [Parameter]
    public int ScreenCount { get; set; }

    /// <summary>Число предупреждений и ошибок на вкладке «Ошибки»: разбор панели, данные ПЛК, разделы, которые не построены.</summary>
    [Parameter]
    public int WarningCount { get; set; }

    /// <summary>Строк таблицы раздела после фильтра; <c>null</c> — таблица не показана.</summary>
    [Parameter]
    public int? RowCount { get; set; }

    /// <summary>Всего строк таблицы раздела; <c>null</c> — таблица не показана.</summary>
    [Parameter]
    public int? RowTotal { get; set; }

    /// <summary>Сообщение об ошибке действия в окне (строка не скопирована); <c>null</c> — нет.</summary>
    [Parameter]
    public string? Notice { get; set; }
}
