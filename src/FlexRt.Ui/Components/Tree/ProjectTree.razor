@if (Loading)
{
    <div class="tree-empty">@Hints.Reading</div>
}
else if (FileName is null || View is null)
{
    <div class="tree-empty">@Hints.NoFile</div>
}
else
{
    <RadzenTree Value="Selected" Change="OnChange" class="project-tree">
        <RadzenTreeItem Text="@FileName" Value="RootKey" Expanded="true">
            <Template><Icon Name="file" /><span class="tree-text">@context.Text</span></Template>
            <ChildContent>
                @Section(View.Summary)
                @Section(View.Tags)
                @if (View.Alarms.Count > 0)
                {
                    @SectionFolder("HMI alarms", View.Alarms)
                }
                @if (Any(OfKind(ScreenKind.Screen)) || View.Screens.Table.Rows.Count > 0 || View.Screens.Error is not null)
                {
                    <RadzenTreeItem Text="Screens" Value="View.Screens" Selected="@ReferenceEquals(View.Screens, Selected)" Expanded="true">
                        <Template><Icon Name="folder" /><span class="tree-text">@context.Text</span>@Badge(View.Screens)</Template>
                        <ChildContent>@Items(OfKind(ScreenKind.Screen))</ChildContent>
                    </RadzenTreeItem>
                }
                @if (Any(OfKind(ScreenKind.PopUp)) || Any(OfKind(ScreenKind.SlideIn)) || Any(OfKind(ScreenKind.PermanentArea)))
                {
                    <RadzenTreeItem Text="Screen management" Value="@("Screen management")" Expanded="true">
                        <Template><Icon Name="folder" /><span class="tree-text">@context.Text</span></Template>
                        <ChildContent>
                            @if (Any(OfKind(ScreenKind.PopUp)))
                            {
                                @Folder("Pop-up screens", OfKind(ScreenKind.PopUp))
                            }
                            @if (Any(OfKind(ScreenKind.SlideIn)))
                            {
                                @Folder("Slide-in screens", OfKind(ScreenKind.SlideIn))
                            }
                            @Items(OfKind(ScreenKind.PermanentArea))
                        </ChildContent>
                    </RadzenTreeItem>
                }
                @if (Any(Unrecognized))
                {
                    @Folder("Вид не опознан", Unrecognized)
                }
                @if (Pictures.Items.Count > 0)
                {
                    <RadzenTreeItem Text="@PanelPictures.Title" Value="Pictures" Selected="@ReferenceEquals(Pictures, Selected)">
                        <Template><Icon Name="picture" /><span class="tree-text">@context.Text</span><Count Value="Pictures.Items.Count" /></Template>
                    </RadzenTreeItem>
                }
                @if (View.Texts.Count > 0)
                {
                    @SectionFolder("Тексты", View.Texts)
                }
            </ChildContent>
        </RadzenTreeItem>
    </RadzenTree>
}

@code {
    /// <summary>Значение корневого узла (файла панели) в дереве.</summary>
    private const string RootKey = "";

    /// <summary>Идёт чтение файла: вместо дерева — подсказка о чтении.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Имя файла панели для корневого узла; <c>null</c> — файл не открыт.</summary>
    [Parameter]
    public string? FileName { get; set; }

    /// <summary>Разделы открытой панели; <c>null</c> — файл не открыт.</summary>
    [Parameter]
    public PanelView? View { get; set; }

    /// <summary>Экраны панели в порядке листа «Экраны».</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ScreenItem> Screens { get; set; } = [];

    /// <summary>Картинки панели для узла «Картинки»; нет — узла нет.</summary>
    [Parameter, EditorRequired]
    public PanelPictures Pictures { get; set; } = PanelPictures.None;

    /// <summary>
    /// Выбранный узел: экран (<see cref="ScreenItem"/>), раздел (<see cref="PanelSection"/>) или картинки
    /// (<see cref="PanelPictures"/>); подсвечивается.
    /// </summary>
    [Parameter]
    public object? Selected { get; set; }

    /// <summary>Щелчок по экрану, разделу (в том числе по папке Screens — таблица листа «Экраны») или узлу «Картинки».</summary>
    [Parameter]
    public EventCallback<object> OnSelect { get; set; }

    /// <summary>Узел раздела: значок, имя и отметка справа (<see cref="Badge"/>).</summary>
    /// <returns>Разметка узла.</returns>
    private RenderFragment Section(PanelSection section) =>
        @<RadzenTreeItem Text="@section.Title" Value="section" Selected="@ReferenceEquals(section, Selected)">
            <Template>
                <Icon Name="@section.Icon" /><span class="tree-text">@context.Text</span>@Badge(section)
            </Template>
        </RadzenTreeItem>;

    /// <summary>
    /// Отметка справа от узла раздела: таблица не построена — красный значок с причиной во всплывающей подсказке;
    /// иначе, кроме «Сводки», — число строк таблицы.
    /// </summary>
    /// <returns>Разметка отметки.</returns>
    private static RenderFragment Badge(PanelSection section) => __builder =>
    {
        if (section.Error is not null)
        {
            <span class="tree-error" title="@section.Error">⚠</span>
        }
        else if (!section.IsSummary)
        {
            <Count Value="section.Table.Rows.Count" />
        }
    };

    /// <summary>Папка дерева с узлами разделов <paramref name="sections"/>; раскрыта.</summary>
    /// <returns>Разметка папки.</returns>
    private RenderFragment SectionFolder(string title, IReadOnlyList<PanelSection> sections) =>
        @<RadzenTreeItem Text="@title" Value="title" Expanded="true">
            <Template><Icon Name="folder" /><span class="tree-text">@context.Text</span></Template>
            <ChildContent>
                @foreach (var section in sections)
                {
                    @Section(section)
                }
            </ChildContent>
        </RadzenTreeItem>;

    /// <summary>Папка дерева с экранами, которые отбирает <paramref name="filter"/>; раскрыта.</summary>
    /// <returns>Разметка папки.</returns>
    private RenderFragment Folder(string title, Func<ScreenItem, bool> filter) =>
        @<RadzenTreeItem Text="@title" Value="title" Expanded="true">
            <Template><Icon Name="folder" /><span class="tree-text">@context.Text</span></Template>
            <ChildContent>@Items(filter)</ChildContent>
        </RadzenTreeItem>;

    /// <summary>Узлы экранов, которые отбирает <paramref name="filter"/>, в порядке листа; у стартового — значок ▶.</summary>
    /// <returns>Разметка узлов.</returns>
    private RenderFragment Items(Func<ScreenItem, bool> filter) =>
        @<text>
            @foreach (var item in Screens.Where(filter))
            {
                <RadzenTreeItem Text="@item.Name" Value="item" Selected="@ReferenceEquals(item, Selected)">
                    <Template>
                        <Icon Name="@IconOf(item.Kind)" /><span class="tree-text">@context.Text</span>
                        @if (item.IsStart)
                        {
                            <span class="start-mark" title="Стартовый экран">▶</span>
                        }
                    </Template>
                </RadzenTreeItem>
            }
        </text>;

    /// <summary>Есть ли экраны, которые отбирает <paramref name="filter"/>.</summary>
    /// <returns><c>true</c>, если есть хотя бы один.</returns>
    private bool Any(Func<ScreenItem, bool> filter) => Screens.Any(filter);

    /// <summary>Отбор экранов одного вида.</summary>
    /// <returns>Условие отбора.</returns>
    private static Func<ScreenItem, bool> OfKind(string kind) => s => s.Kind == kind;

    /// <summary>Отбор экранов неопознанного вида (<see cref="ScreenKind.IsUnrecognized"/>): <c>?</c> и любые новые.</summary>
    /// <returns><c>true</c> для экрана неопознанного вида.</returns>
    private static bool Unrecognized(ScreenItem item) => ScreenKind.IsUnrecognized(item.Kind);

    /// <summary>Щелчок по узлу дерева: экран, раздел или картинки — сообщить о выборе; другая папка или файл — только подсветка.</summary>
    private async Task OnChange(TreeEventArgs args)
    {
        if (args.Value is ScreenItem or PanelSection or PanelPictures)
        {
            await OnSelect.InvokeAsync(args.Value);
        }
    }

    /// <summary>Значок экрана по виду: pop-up — свой, неопознанный вид — пунктирный, остальные — обычный экран.</summary>
    /// <returns>Имя значка для <c>Icon</c>.</returns>
    private static string IconOf(string kind) => kind switch
    {
        ScreenKind.PopUp => "popup",
        ScreenKind.Screen or ScreenKind.SlideIn or ScreenKind.PermanentArea => "screen",
        _ => "unknown"
    };
}
