@using System.Runtime.InteropServices
@using System.Windows

<div class="report-grid">
    <RadzenDataGrid @ref="_grid" TItem="IDictionary<string, object>" Data="_rows" @bind-Value="_selection" RowSelect="SelectRow"
                    Render="OnRender" KeyDown="OnKeyDown" SelectionMode="DataGridSelectionMode.Single" AllowSorting="true" AllowFiltering="true"
                    FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowVirtualization="true"
                    AllowColumnResize="true" Density="Density.Compact" ColumnWidth="180px" EmptyText="Нет строк" class="section-grid">
        <Columns>
            @foreach (var column in _columns)
            {
                <RadzenDataGridColumn @key="column.Key" @ref="_gridColumns[column.Key]" TItem="IDictionary<string, object>" Title="@column.Title"
                                      Type="@column.ValueType" Visible="@Shown(column)"
                                      Property="@PropertyAccess.GetDynamicPropertyExpression(column.Key, column.ValueType)"
                                      FilterOperator="@(column.IsNumber ? FilterOperator.Equals : FilterOperator.Contains)"
                                      TextAlign="@(column.IsNumber ? TextAlign.Right : TextAlign.Left)">
                    <Template>
                        @{
                            var cell = CellOf(context, column);
                            var text = cell.DisplayIn(Language);
                        }
                        @if (cell.FillRgb is { } rgb)
                        {
                            <span class="swatch" style="background:@CssColor.Hex(rgb)"></span>
                        }
                        <span title="@text">@text</span>
                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    /// <summary>Таблица Radzen: из неё берётся число строк после фильтра.</summary>
    private RadzenDataGrid<IDictionary<string, object>>? _grid;

    /// <summary>Колонки показываемой таблицы.</summary>
    private IReadOnlyList<GridColumn> _columns = [];

    /// <summary>Колонки таблицы Radzen по ключу <see cref="GridColumn.Key"/>: у них сбрасывается фильтр.</summary>
    private readonly Dictionary<string, RadzenDataGridColumn<IDictionary<string, object>>> _gridColumns = [];

    /// <summary>Язык, колонки которого показаны сейчас (<see cref="Language"/> прошлой отрисовки).</summary>
    private int? _shownLanguage;

    /// <summary>Строки показываемой таблицы в порядке листа.</summary>
    private List<IDictionary<string, object>> _rows = [];

    /// <summary>Выделенная строка таблицы Radzen (одна или ни одной).</summary>
    private IList<IDictionary<string, object>>? _selection;

    /// <summary>Число строк после фильтра, о котором уже сообщено <see cref="OnCountChanged"/>.</summary>
    private int? _reportedCount;

    /// <summary>Таблица листа; у экземпляра не меняется — <c>SectionView</c> задаёт ключ <c>@key</c> по разделу.</summary>
    [Parameter, EditorRequired]
    public ReportTable Table { get; set; } = null!;

    /// <summary>Номер выбранной строки листа с нуля; <c>null</c> — не выбрана.</summary>
    [Parameter]
    public int? SelectedRow { get; set; }

    /// <summary>Язык (LCID), колонки которого видны; колонки других языков скрыты. <c>null</c> — видны все языки.</summary>
    [Parameter]
    public int? Language { get; set; }

    /// <summary>Выбор строки: номер строки листа с нуля по щелчку; <c>null</c> — фильтр скрыл выбранную строку, выбор снят.</summary>
    [Parameter]
    public EventCallback<int?> OnRowSelect { get; set; }

    /// <summary>Изменилось число строк после фильтра.</summary>
    [Parameter]
    public EventCallback<int> OnCountChanged { get; set; }

    /// <summary>Строку не удалось скопировать в буфер обмена: текст ошибки.</summary>
    [Parameter]
    public EventCallback<string> OnCopyFailed { get; set; }

    /// <summary>Построить колонки и строки таблицы один раз: другая таблица — другой экземпляр компонента.</summary>
    protected override void OnInitialized()
    {
        _columns = GridData.Columns(Table);
        _rows = GridData.Rows(Table, _columns, Language);
        _shownLanguage = Language;
    }

    /// <summary>
    /// Выделение — по <see cref="SelectedRow"/>. Сменился язык — ячейки с текстами на языках переводятся на него, у колонок,
    /// которые скрылись, сбрасываются фильтр и сортировка (<see cref="ApplyLanguageAsync"/>).
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        _selection = SelectedRow is { } row && row < _rows.Count ? [_rows[row]] : [];
        if (Language == _shownLanguage)
        {
            return;
        }
        _shownLanguage = Language;
        await ApplyLanguageAsync();
    }

    /// <summary>
    /// Перевести ячейки с текстами на языках на <see cref="Language"/> (<see cref="GridData.SetLanguage"/>), у скрытых колонок
    /// сбросить фильтр — любой, и без значения («Is empty» и т. п.), — и сортировку (решение пользователя: невидимые
    /// фильтр и сортировка не должны менять таблицу), затем один раз пересчитать строки.
    /// </summary>
    private async Task ApplyLanguageAsync()
    {
        GridData.SetLanguage(_rows, Table, _columns, Language);
        if (_grid is null)
        {
            return;
        }
        List<RadzenDataGridColumn<IDictionary<string, object>>> hidden =
            [.. _columns.Where(c => !Shown(c)).Select(c => _gridColumns.GetValueOrDefault(c.Key)).OfType<RadzenDataGridColumn<IDictionary<string, object>>>()];
        foreach (var column in hidden)
        {
            column.ClearFilters();
        }
        if (hidden.Any(c => c.GetSortOrder() is not null))
        {
            // сортировка по одной колонке (AllowMultiColumnSorting выключен) и она скрыта: очистка Sorts снимает её у всех
            // колонок и сама пересчитывает строки (Radzen ставит Reload в очередь)
            _grid.Sorts.Clear();
            return;
        }
        await _grid.Reload();
    }

    /// <summary>Колонка видна: не языковая, её язык выбран или выбраны все языки (<see cref="Language"/>).</summary>
    /// <returns><c>true</c> для видимой колонки.</returns>
    private bool Shown(GridColumn column) => column.Language is null || Language is null || column.Language == Language;

    /// <summary>Ячейка таблицы листа для строки Radzen и колонки: из неё берутся текст и заливка.</summary>
    /// <returns>Ячейка листа.</returns>
    private ReportCell CellOf(IDictionary<string, object> row, GridColumn column) =>
        Table.Rows[(int)row[GridData.RowKey]][column.Index];

    /// <summary>Щелчок по строке — сообщить номер строки листа.</summary>
    private Task SelectRow(IDictionary<string, object> row) => OnRowSelect.InvokeAsync((int)row[GridData.RowKey]);

    /// <summary>Выбранная строка осталась среди строк после фильтра.</summary>
    /// <returns><c>true</c>, если строка не выбрана или видна.</returns>
    private bool SelectedVisible(IQueryable<IDictionary<string, object>> view) =>
        SelectedRow is not { } row || view.Any(r => (int)r[GridData.RowKey] == row);

    /// <summary>
    /// После отрисовки таблицы Radzen: фильтр скрыл выбранную строку — снять выбор (<see cref="OnRowSelect"/> с <c>null</c>);
    /// число строк после фильтра изменилось — сообщить. Событие Radzen синхронное, поэтому ожидать сообщения здесь нельзя:
    /// они лишь перерисовывают окно.
    /// </summary>
    private void OnRender(DataGridRenderEventArgs<IDictionary<string, object>> args)
    {
        if (_grid is null)
        {
            return;
        }
        if (!SelectedVisible(_grid.View))
        {
            _ = OnRowSelect.InvokeAsync(null);
        }
        var count = _grid.View.Count();
        if (count == _reportedCount)
        {
            return;
        }
        _reportedCount = count;
        _ = OnCountChanged.InvokeAsync(count);
    }

    /// <summary>
    /// Ctrl+C — выбранную строку в буфер обмена: значения ячеек через табуляцию, ячейка с табуляцией, переносом строки или
    /// кавычкой — в кавычках (<see cref="ClipboardRow"/>); при вставке в Excel строка ложится в одну строку по ячейкам.
    /// Клавиша определяется по коду (<c>KeyC</c>), чтобы работало и в русской раскладке. Буфер занят другой программой —
    /// текст ошибки в <see cref="OnCopyFailed"/>.
    /// </summary>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!e.CtrlKey || e.Code != "KeyC" || SelectedRow is not { } row || row >= Table.Rows.Count)
        {
            return;
        }
        try
        {
            Clipboard.SetText(ClipboardRow.Text(Table.Rows[row]));
        }
        catch (ExternalException ex)
        {
            await OnCopyFailed.InvokeAsync($"Строка не скопирована: {ex.Message}");
        }
    }
}
