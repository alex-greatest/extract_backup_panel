<div class="editor-title">
    <span class="editor-title-text">@Title</span>
    @if (HasLanguageChoice())
    {
        <RadzenDropDown TValue="int" Data="_languageItems" Value="@(Language ?? AllLanguages)" Change="ChangeLanguage"
                        class="language" title="Язык текстов">
            <Template Context="lcid">@LanguageLabel(lcid)</Template>
            <ValueTemplate Context="lcid">@LanguageLabel(lcid)</ValueTemplate>
        </RadzenDropDown>
    }
</div>
@if (Section.Statistics.Count > 0)
{
    <div class="section-stats">
        @foreach (var (label, count) in Section.Statistics)
        {
            <span>@label: <b>@count</b></span>
        }
    </div>
}
@if (Section.Error is not null)
{
    <div class="section-error"><RadzenIcon Icon="error" /> Раздел не построен: @Section.Error</div>
}
else if (Section.IsSummary)
{
    <div class="summary-scroll">
        <table class="summary-list">
            @foreach (var cells in Section.Table.Rows)
            {
                @if (cells.All(c => c.Display == ""))
                {
                    <tr class="summary-gap"><td colspan="2"></td></tr>
                }
                else
                {
                    <tr>
                        <td>@cells[0].Display</td>
                        <td>@cells[1].Display</td>
                    </tr>
                }
            }
        </table>
    </div>
}
else
{
    @* ключ — раздел: у каждой таблицы свой экземпляр, иначе Radzen переносит фильтр колонки c0 на колонку другого типа *@
    <ReportGrid @key="Section" Table="Section.Table" Language="Language" SelectedRow="SelectedRow" OnRowSelect="OnRowSelect" OnCountChanged="OnCountChanged" OnCopyFailed="OnCopyFailed" />
}

@code {
    /// <summary>Пункт «Все языки» в списке языков: LCID такого не бывает.</summary>
    private const int AllLanguages = -1;

    /// <summary>Пункты списка языков: «Все языки» и <see cref="Languages"/>; строятся заново, только когда меняется список языков.</summary>
    private IReadOnlyList<int> _languageItems = [AllLanguages];

    /// <summary>Список языков, из которого построены <see cref="_languageItems"/>.</summary>
    private IReadOnlyList<int>? _itemsLanguages;

    /// <summary>Строка заголовка: путь раздела, как у экрана.</summary>
    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>Показываемый раздел.</summary>
    [Parameter, EditorRequired]
    public PanelSection Section { get; set; } = null!;

    /// <summary>Языки панели (LCID) в порядке STRINGSTORE — пункты списка языков после «Все языки».</summary>
    [Parameter]
    public IReadOnlyList<int> Languages { get; set; } = [];

    /// <summary>Выбранный язык (LCID): видны колонки только этого языка; <c>null</c> — все языки.</summary>
    [Parameter]
    public int? Language { get; set; }

    /// <summary>Выбран другой язык в списке: LCID; <c>null</c> — «Все языки».</summary>
    [Parameter]
    public EventCallback<int?> LanguageChanged { get; set; }

    /// <summary>Номер выбранной строки листа с нуля; <c>null</c> — не выбрана.</summary>
    [Parameter]
    public int? SelectedRow { get; set; }

    /// <summary>Выбор строки таблицы: номер строки листа с нуля; <c>null</c> — фильтр скрыл выбранную строку.</summary>
    [Parameter]
    public EventCallback<int?> OnRowSelect { get; set; }

    /// <summary>Изменилось число строк таблицы после фильтра.</summary>
    [Parameter]
    public EventCallback<int> OnCountChanged { get; set; }

    /// <summary>Строку не удалось скопировать в буфер обмена: текст ошибки.</summary>
    [Parameter]
    public EventCallback<string> OnCopyFailed { get; set; }

    /// <summary>Новый список языков — заново построить пункты списка (<see cref="_languageItems"/>).</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_itemsLanguages, Languages))
        {
            return;
        }
        _itemsLanguages = Languages;
        _languageItems = [AllLanguages, .. Languages];
    }

    /// <summary>
    /// Список языков показывается: у панели больше одного языка, раздел построен, не «Сводка» и в таблице есть языковые
    /// колонки.
    /// </summary>
    /// <returns><c>true</c>, если список нужен.</returns>
    private bool HasLanguageChoice() =>
        Languages.Count > 1 && Section is { Error: null, IsSummary: false } && Section.Table.ColumnLanguages.Any(l => l is not null);

    /// <summary>Текст пункта списка языков: «Все языки» или код и название языка (<see cref="LanguageText.Format"/>).</summary>
    /// <returns>Текст пункта.</returns>
    private static string LanguageLabel(int lcid) => lcid == AllLanguages ? "Все языки" : LanguageText.Format(lcid);

    /// <summary>Выбран пункт списка языков: сообщить LCID, у «Все языки» — <c>null</c>.</summary>
    private Task ChangeLanguage(object value) =>
        LanguageChanged.InvokeAsync(value is int lcid && lcid != AllLanguages ? lcid : null);
}
