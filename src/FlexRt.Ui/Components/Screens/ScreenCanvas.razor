@using System.Globalization
@using FlexRt.Model.Panel.Screens
@inject ObjectSelection Selection

@{
    var drawn = Drawn(Item);
}
<div class="editor-title">@Title</div>
<div class="canvas-scroll">
    @if (drawn is not { } d)
    {
        <div class="canvas-empty">@(Item is null ? Empty : NothingToDraw(Item))</div>
    }
    else
    {
        var (item, height) = d;
        var total = (item.Strip?.Height ?? 0) + height;
        <div class="screen-frame" style="width:@Px(item.Screen.Width); height:@Px(total);">
            <div class="screen-scale" style="width:@(item.Screen.Width)px; height:@(total)px; transform:scale(@Scale()); --zoom:@Scale();">
                @if (item.Strip is { } strip)
                {
                    <div class="permanent-strip" style="height:@(strip.Height)px; @Background(strip.BackgroundRgb)" title="Permanent area"
                         @onclick="() => Selection.Select(item, null)">
                        @ObjectFrames(item, strip.Objects)
                    </div>
                }
                <div class="@ScreenClass(item)" style="height:@(height)px; @Background(item.Screen.BackgroundRgb)"
                     @onclick="() => Selection.Select(item, null)">
                    @ObjectFrames(item, item.Objects)
                </div>
            </div>
        </div>
    }
</div>
<div class="editor-footer">
    @if (drawn is { } shown)
    {
        <span class="muted-inline">@shown.Item.Screen.Width × @shown.Height px</span>
        @if (OverPanel(shown.Item.Strip, shown.Height) is { } over)
        {
            <span class="canvas-warning">@over</span>
        }
    }
    <span class="spacer"></span>
    <RadzenDropDown TValue="int" Data="Zooms" @bind-Value="_zoom" class="zoom" title="Масштаб">
        <Template Context="z">@z%</Template>
        <ValueTemplate Context="z">@z%</ValueTemplate>
    </RadzenDropDown>
</div>

@code {
    /// <summary>Доступные масштабы холста в процентах.</summary>
    private static readonly int[] Zooms = [25, 50, 75, 100, 125, 150, 200];

    /// <summary>Текущий масштаб в процентах.</summary>
    private int _zoom = 100;

    /// <summary>Экран, показанный при прошлой отрисовке: смена экрана снимает выбор объекта.</summary>
    private ScreenItem? _shown;

    /// <summary>
    /// Насколько в пикселях окна щелчок может отойти от прошлого и остаться щелчком в той же точке
    /// (<see cref="SelectAt"/>): рука сдвигает мышь между щелчками.
    /// </summary>
    private const int SamePointTolerance = 3;

    /// <summary>Точка прошлого щелчка по объекту в пикселях окна; щелчка ещё не было — <c>null</c>.</summary>
    private (double X, double Y)? _lastClick;

    /// <summary>Строка заголовка редактора: путь к экрану, как в TIA.</summary>
    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>
    /// Экран для показа: прямоугольник его размера (<see cref="ScreenItem.Height"/>), у обычного экрана над ним — полоса
    /// Permanent area (<see cref="ScreenItem.Strip"/>), как в редакторе экранов TIA; <c>null</c> — подсказка <see cref="Empty"/>.
    /// </summary>
    [Parameter]
    public ScreenItem? Item { get; set; }

    /// <summary>Подсказка вместо экрана: файл не открыт, читается или экран не выбран.</summary>
    [Parameter]
    public string Empty { get; set; } = Hints.NoScreen;

    /// <summary>Сменился экран — выбор объекта снимается (<see cref="ObjectSelection"/>).</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Item, _shown))
        {
            return;
        }
        _shown = Item;
        Selection.Select(Item, null);
    }

    /// <summary>Множитель масштаба для CSS в инвариантной культуре (<c>0.75</c>).</summary>
    /// <returns>Текст множителя.</returns>
    private string Scale() => (_zoom / 100.0).ToString(CultureInfo.InvariantCulture);

    /// <summary>
    /// Заливка экрана или полосы Permanent area цветом фона из файла
    /// (<see cref="FlexRt.Model.Panel.Screens.Screen.BackgroundRgb"/>, тот же, что в колонке Background color листа
    /// «Экраны»); цвет не прочитан — цвет холста из CSS.
    /// </summary>
    /// <returns>Текст CSS, например <c>background-color:#b6b6b6;</c>; цвета нет — пусто.</returns>
    private static string Background(int? rgb) => rgb is { } color ? $"background-color:{CssColor.Hex(color)};" : "";

    /// <summary>
    /// Классы прямоугольника экрана: у узла Permanent area объекты за его высотой обрезаются, как в полосе над
    /// экраном; у остальных экранов объекты за краем видны (решение пользователя 2026-11-02).
    /// </summary>
    /// <returns><c>screen clipped</c> у Permanent area, иначе <c>screen</c>.</returns>
    private static string ScreenClass(ScreenItem item) => item.Kind == ScreenKind.PermanentArea ? "screen clipped" : "screen";

    /// <summary>
    /// Экран, который рисуется, и его высота: экран выбран, высота известна и это не Permanent area высотой 0
    /// (тогда вместо рисунка — <see cref="NothingToDraw"/>). Высота не известна только у Permanent area.
    /// </summary>
    /// <returns>Экран и высота; рисовать нечего — <c>null</c>.</returns>
    private static (ScreenItem Item, int Height)? Drawn(ScreenItem? item) => item switch
    {
        { Height: { } height } when height > 0 || item.Kind != ScreenKind.PermanentArea => (item, height),
        _ => null
    };

    /// <summary>
    /// Предупреждение под холстом: полоса Permanent area и экран вместе выше панели (высота записи Permanent area).
    /// Так бывает, если после смены высоты Permanent area экраны не пересохранены: TIA такой размер экрана не принимает.
    /// </summary>
    /// <returns>Текст вида <c>Permanent area 80 + экран 420 &gt; панель 480</c>; помещается или высоты панели нет — <c>null</c>.</returns>
    private static string? OverPanel(PermanentStrip? strip, int height) =>
        strip is { PanelHeight: { } panel } && strip.Height + height > panel
            ? $"Permanent area {strip.Height} + экран {height} > панель {panel}"
            : null;

    /// <summary>
    /// Подсказка вместо рисунка: высота Permanent area 0 — <see cref="Hints.NoPermanentArea"/>, высота не прочитана —
    /// <see cref="Hints.PermanentAreaHeightUnknown"/>.
    /// </summary>
    /// <returns>Текст подсказки.</returns>
    private static string NothingToDraw(ScreenItem item) =>
        item.Height is null ? Hints.PermanentAreaHeightUnknown : Hints.NoPermanentArea;

    /// <summary>
    /// Объекты экрана в порядке списка: положение и размер как в Layout TIA, в пикселях экрана. I/O field
    /// (<see cref="ScreenItem.Fields"/>) — как в редакторе TIA: фон, рамка, шаблон нулями шрифтом и цветом из файла
    /// (<see cref="IoFieldCss"/>, <see cref="IoFieldTexts.Sample"/>); остальные — рамка с именем объекта (решение
    /// пользователя 2026-11-02), у линии ширина или высота 0 — рамка в 1 px. Щелчок выбирает объект
    /// (<see cref="SelectAt"/>, <see cref="ObjectSelection"/>): первым — самый маленький под курсором (решение пользователя
    /// 2026-11-05), повторный щелчок в той же точке перебирает по кругу остальные, так добирается и до большого под
    /// маленьким (решение пользователя 2026-11-04); у выбранного — маркеры
    /// по углам и серединам сторон, как в TIA; имя — в подсказке.
    /// </summary>
    /// <returns>Разметка объектов.</returns>
    private RenderFragment ObjectFrames(ScreenItem item, IReadOnlyList<ScreenObject> objects) => __builder =>
    {
        var selected = Selection.Of(item);
        foreach (var o in objects)
        {
            var field = item.Fields.GetValueOrDefault(o.Element);
            var css = (Equals(o, selected) ? "screen-object selected" : "screen-object") + (field is null ? "" : " io-field");
            <div class="@css" style="@FrameStyle(o.Bounds) @(field is null ? "" : IoFieldCss.Box(field))" title="@o.Name"
                 @onclick="e => SelectAt(item, objects, o, e)" @onclick:stopPropagation="true">
                @if (field is null)
                {
                    <span>@o.Name</span>
                }
                else
                {
                    <span style="@IoFieldCss.Text(field)">
                        @if (IoFieldGlyphs.Layout(field) is { } glyphs)
                        {
                            foreach (var (glyph, width) in glyphs)
                            {
                                <span class="io-glyph" style="width:@(width)px">@glyph</span>
                            }
                        }
                        else
                        {
                            @IoFieldTexts.Sample(field)
                        }
                    </span>
                }
            </div>
        }
    };

    /// <summary>
    /// Выбрать объект по щелчку, перебирая перекрытые. Точка щелчка в пикселях экрана — левый верхний угол объекта
    /// <paramref name="clicked"/> плюс смещение внутри него (<see cref="MouseEventArgs.OffsetX"/> считается от внутреннего
    /// края рамки, поэтому прибавляется ширина рамки I/O field; текст не ловит клик, CSS <c>pointer-events: none</c>).
    /// Стопка — объекты под точкой от меньшего к большему (<see cref="Under"/>); округление вынесло точку за
    /// <paramref name="clicked"/> — он добавляется первым, стопка не пуста. Та же точка (<see cref="IsLastClick"/>) и выбран
    /// объект стопки — следующий по кругу; иначе — первый в стопке, а не <paramref name="clicked"/>: выбранный объект поднят
    /// над соседями и перехватывает щелчок. Выбор идёт через <see cref="ObjectSelection"/>.
    /// </summary>
    private void SelectAt(ScreenItem item, IReadOnlyList<ScreenObject> objects, ScreenObject clicked, MouseEventArgs e)
    {
        var border = item.Fields.TryGetValue(clicked.Element, out var field) ? IoFieldCss.BorderWidth(field) : 0;
        var x = clicked.Bounds.Left + (int)Math.Floor(e.OffsetX + border);
        var y = clicked.Bounds.Top + (int)Math.Floor(e.OffsetY + border);
        var under = Under(objects, x, y);
        if (!under.Contains(clicked))
        {
            under.Insert(0, clicked);
        }
        var current = Selection.Of(item);
        var index = current is null ? -1 : under.IndexOf(current);
        var repeat = index >= 0 && IsLastClick(e);
        _lastClick = (e.ClientX, e.ClientY);
        Selection.Select(item, repeat ? under[(index + 1) % under.Count] : under[0]);
    }

    /// <summary>
    /// Щелчок в точке прошлого щелчка: отошёл от неё не дальше <see cref="SamePointTolerance"/> пикселей окна. Сравнение —
    /// в координатах окна, поэтому допуск не зависит от масштаба; прокрутка холста между щелчками не учитывается.
    /// </summary>
    /// <returns><c>true</c> — та же точка; щелчка ещё не было или он дальше — <c>false</c>.</returns>
    private bool IsLastClick(MouseEventArgs e) =>
        _lastClick is { } last
        && Math.Abs(e.ClientX - last.X) <= SamePointTolerance
        && Math.Abs(e.ClientY - last.Y) <= SamePointTolerance;

    /// <summary>
    /// Объекты, накрывающие точку (<paramref name="x"/>, <paramref name="y"/>) экрана, от меньшей площади к большей (решение
    /// пользователя 2026-11-05). При равной площади первым идёт верхний: позже в списке — выше на холсте, поэтому список
    /// обходится с конца, а сортировка устойчива. Линия с шириной или высотой 0 накрывает 1 px, как нарисована.
    /// </summary>
    /// <returns>Список объектов, самый маленький первым; под точкой никого — пустой список.</returns>
    private static List<ScreenObject> Under(IReadOnlyList<ScreenObject> objects, int x, int y)
    {
        var hits = new List<ScreenObject>();
        for (var i = objects.Count - 1; i >= 0; i--)
        {
            var b = objects[i].Bounds;
            if (x >= b.Left && x < b.Left + Math.Max(b.Width, 1) && y >= b.Top && y < b.Top + Math.Max(b.Height, 1))
            {
                hits.Add(objects[i]);
            }
        }
        return [..hits.OrderBy(o => Area(o.Bounds))];
    }

    /// <summary>Площадь объекта на холсте: нулевая ширина или высота считается 1 px, как нарисована.</summary>
    /// <returns>Площадь в пикселях экрана.</returns>
    private static long Area(ScreenRect r) => (long)Math.Max(r.Width, 1) * Math.Max(r.Height, 1);

    /// <summary>Положение рамки объекта в CSS.</summary>
    /// <returns>Текст CSS, например <c>left:720px; top:360px; width:78px; height:58px;</c>.</returns>
    private static string FrameStyle(ScreenRect r) =>
        $"left:{r.Left}px; top:{r.Top}px; width:{Math.Max(r.Width, 0)}px; height:{Math.Max(r.Height, 0)}px;";

    /// <summary>Размер рамки экрана в пикселях окна при текущем масштабе: по нему прокручивается холст.</summary>
    /// <returns>Текст CSS, например <c>600px</c>.</returns>
    private string Px(int size) => $"{size * _zoom / 100}px";
}
